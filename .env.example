# =============================================================================
# HisaabPro — Frontend Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:5001/api
VITE_APP_ENV=development
# Login flow: 'otp' (real) or 'dev-login' (username/password, dev only and
# ignored in a production build). Unset means otp.
VITE_AUTH_MODE=otp
VITE_TURNSTILE_SITE_KEY=

# --- Error Tracking (Sentry) ---
# VITE_SENTRY_DSN=  (get from https://sentry.io — Project > Client Keys)

# --- Backend vars are in server/.env ---
# See server/.env.example
