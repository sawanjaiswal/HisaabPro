model ApprovalRequest {
  id               String    @id @default(cuid())
  businessId       String
  type             String // EDIT_LOCKED_TRANSACTION, DELETE_TRANSACTION, PRICE_OVERRIDE, DISCOUNT_OVERRIDE
  entityType       String
  entityId         String
  requestedBy      String
  requestedChanges Json
  status           String    @default("PENDING") // PENDING, APPROVED, DENIED, EXPIRED
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requester User     @relation("ApprovalRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer  User?    @relation("ApprovalReviewer", fields: [reviewedBy], references: [id])

  @@index([businessId, status])
  @@index([requestedBy])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  action      String // CREATE, UPDATE, DELETE, RESTORE, LOCK_OVERRIDE, PIN_RESET, ROLE_CHANGE, APPROVAL_REQUEST, APPROVAL_RESPONSE
  entityType  String
  entityId    String
  entityLabel String?
  userId      String? // nullable: cron/system actors use systemActor instead
  systemActor String?  @db.VarChar(50) // MB-7: identifies cron job or system process
  changes     Json?
  reason      String?
  ipAddress   String?
  deviceInfo  String?
  createdAt   DateTime @default(now())

  // Phase 6 — full-text search vector for /api/audit?q=... (architecture §7.5).
  // Auto-populated by a Postgres trigger (`audit_log_search_vector_update`)
  // from action + entityType + entityLabel + reason. GIN index is added in
  // the same migration via raw SQL (Prisma can't emit GIN on tsvector;
  // .claude/rules/PRISMA_MIGRATION_RULES.md).
  searchVector Unsupported("tsvector")?

  // Phase 6 — record of field paths that were redacted from `changes` before
  // storage, per the per-business AuditLogRedaction config. JSON array shape;
  // empty object = no redaction. Architecture §7.6.
  redactedFields Json @default("{}")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  // NOTE: searchVector GIN index lives in migration.sql as raw SQL.

  // Immutable — no updatedAt
  @@index([businessId, createdAt])
  @@index([businessId, entityType])
  @@index([userId])
}

// === Referral & Earn — Feature #3 ===

