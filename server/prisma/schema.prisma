  pinAttempts        Int       @default(0)
  pinLockedUntil     DateTime?
  biometricEnabled   Boolean   @default(false)
  calculatorPosition String    @default("BOTTOM_RIGHT")
  language           String    @default("en")
  theme              String    @default("light")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === Admin Panel ===

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponAppliesTo {
  FIRST_CYCLE
  ALL_CYCLES
  ONE_TIME
}

/// Platform admin accounts — separate from regular User table
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             AdminRole @default(ADMIN)
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // TOTP secret (encrypted at rest)

  // Security tracking
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  accountLockedUntil  DateTime?
  lastFailedLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions        AdminAction[]
  couponsCreated Coupon[]

  @@index([email])
  @@index([role, isActive])
}

/// Immutable audit trail — every admin action is recorded here
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String // SUSPEND_USER, UNSUSPEND_USER, VIEW_USER, UPDATE_SETTINGS, LOGIN, LOGOUT
  targetType String? // USER, BUSINESS, SETTINGS
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  // Immutable — no updatedAt
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// User suspension records — tracks who suspended whom and why
model UserSuspension {
  id          String    @id @default(cuid())
  userId      String    @unique
  suspendedBy String // AdminUser.id
  reason      String
  notes       String?
  suspendedAt DateTime  @default(now())
  liftedAt    DateTime?
  liftedBy    String? // AdminUser.id
  liftNotes   String?

  @@index([userId])
  @@index([suspendedBy])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 2 — GST & Compliance
// ═══════════════════════════════════════════════════════════════════════════════

/// Tax rate category — "GST 18%", "GST 5%", "Exempt", etc.
model TaxCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String // "GST 18%", "GST 5%", "Exempt"
  rate       Int       @default(0) // basis points (1800 = 18.00%)
  cessRate   Int       @default(0) // basis points for additional cess
  cessType   String    @default("PERCENTAGE") // PERCENTAGE, FIXED_PER_UNIT
  hsnCode    String? // Default HSN for this category
  sacCode    String? // Default SAC for this category
  isDefault  Boolean   @default(false) // System-created defaults (0%, 5%, 12%, 18%, 28%)
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, isDeleted])
}

/// Pre-seeded HSN/SAC code database (~12K records, read-only)
model HsnCode {
  code           String  @id // 4-8 digit HSN code
  description    String
  chapter        String? // 2-digit chapter (first 2 digits)
  defaultRate    Int     @default(0) // basis points — default GST rate
  cessApplicable Boolean @default(false)
  cessRate       Int     @default(0) // basis points
  uqc            String  @default("NOS") @db.VarChar(10) // Unit Quantity Code per CGST — GST Phase 2
  // description search uses a pg_trgm GIN index (raw SQL migration
  // hsn_description_trgm) — a B-tree can't accelerate ILIKE '%q%'.

  @@index([chapter])
}

/// E-Invoice record — IRN + QR from NIC IRP portal
model EInvoice {
  id            String    @id @default(cuid())
  documentId    String    @unique
  irn           String    @unique // 64-char hash from NIC
  ackNumber     String // Acknowledgement number
  ackDate       DateTime
  qrCodeData    String    @db.Text // Base64 or raw QR data
  signedInvoice Json // Full signed invoice JSON from NIC
  status        String    @default("GENERATED") // GENERATED, CANCELLED
  cancelReason  String?
  cancelledAt   DateTime?
  rawResponse   Json? // Full NIC response for debugging
  createdAt     DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([status])
}

/// E-Way Bill record
model EWayBill {
  id              String    @id @default(cuid())
  documentId      String    @unique
  ewbNumber       String    @unique
  ewbDate         DateTime
  validUpto       DateTime
  transportMode   String    @default("ROAD") // ROAD, RAIL, AIR, SHIP
  transporterId   String?
  transporterName String?
  vehicleNumber   String?
  vehicleType     String? // REGULAR, ODC (over-dimensional cargo)
  distance        Int       @default(0) // kilometers
  fromPincode     String
  toPincode       String
  status          String    @default("ACTIVE") // ACTIVE, CANCELLED, EXTENDED
  cancelReason    String?
  cancelledAt     DateTime?
  partBUpdates    Json      @default("[]") // Array of vehicle change records
  createdAt       DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([status])
  @@index([ewbNumber])
}

/// GST return filing tracker
model GstReturn {
  id                String    @id @default(cuid())
  businessId        String
  period            String // "2026-01" (YYYY-MM)
  returnType        String // GSTR1, GSTR3B, GSTR9
  status            String    @default("DRAFT") // DRAFT, EXPORTED, FILED
  filedAt           DateTime?
  jsonData          Json? // Exported JSON data
  summary           Json? // Aggregated summary (tax totals, counts)
  invoiceCount      Int       @default(0)
  totalTaxableValue Int       @default(0) // paise
  totalTax          Int       @default(0) // paise
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, period, returnType])
  @@index([businessId, returnType])
}

// ─── GSTR-1 Reconciliation — Phase 2E ───────────────────────────────────────

model GstReconciliation {
  id         String @id @default(cuid())
  businessId String
  period     String // YYYY-MM
  reconType  String // GSTR1_VS_BOOKS, GSTR2A_VS_BOOKS, GSTR2B_VS_BOOKS
  status     String @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED

  // Summary counts
  totalInvoices      Int @default(0)
  matchedCount       Int @default(0)
  mismatchedCount    Int @default(0)
  missingInGstrCount Int @default(0)
  extraInGstrCount   Int @default(0)

  // Summary amounts (paise)
  totalBookValue  Int @default(0)
  totalGstrValue  Int @default(0)
  differenceValue Int @default(0)

  // The uploaded GSTR data (JSON blob)
  gstrData Json?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries  GstReconciliationEntry[]

  @@unique([businessId, period, reconType])
  @@index([businessId, period])
}

model GstReconciliationEntry {
  id               String @id @default(cuid())
  reconciliationId String

  // Our system data
  documentId       String?
  documentNumber   String?
  documentDate     DateTime?
  partyGstin       String?   @db.VarChar(15)
  partyName        String?
  bookTaxableValue Int       @default(0) // paise
  bookTaxAmount    Int       @default(0) // paise

  // GSTR portal data
  gstrInvoiceNumber String?
  gstrInvoiceDate   DateTime?
  gstrTaxableValue  Int       @default(0) // paise
  gstrTaxAmount     Int       @default(0) // paise

  // Reconciliation result
  matchStatus      String // MATCHED, MISMATCHED, MISSING_IN_GSTR, EXTRA_IN_GSTR
  taxableValueDiff Int    @default(0) // paise (book - gstr)
  taxAmountDiff    Int    @default(0) // paise

  reconciliation GstReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, matchStatus])
}

/// Recurring invoice template — auto-generates invoices on schedule
model RecurringInvoice {
  id                 String    @id @default(cuid())
  businessId         String
  templateDocumentId String // Source document used as template
  partyId            String
  frequency          String // DAILY|WEEKLY|MONTHLY|QUARTERLY|YEARLY
  startDate          DateTime
  endDate            DateTime?
  nextRunDate        DateTime
  dayOfMonth         Int? // 1-28 for MONTHLY
  dayOfWeek          Int? // 0-6 for WEEKLY (0 = Sunday)
  autoSend           Boolean   @default(false)
  status             String    @default("ACTIVE") // ACTIVE|PAUSED|COMPLETED
  generatedCount     Int       @default(0)
  lastGeneratedAt    DateTime?
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Phase 1 additions — all nullable/defaulted for safe additive migration
  name              String?   @db.VarChar(120)
  autoPaymentLink   Boolean   @default(false)
  autoReminder      Boolean   @default(false)
  lastFailureReason String?   @db.VarChar(500)
  cancelledAt       DateTime?
  cancelledBy       String?
  createdBy         String? // userId; nullable for pre-existing rows
  updatedBy         String?
  claimedAt         DateTime? // cron claim watermark
  claimedBy         String?   @db.VarChar(80) // worker id (hostname:pid)

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documents Document[]
  runs      RecurringInvoiceRun[]

  @@index([businessId, status])
  @@index([nextRunDate, status])
  @@index([businessId, isDeleted])
  @@index([businessId, partyId])
  @@index([status, claimedAt])
}

/// One execution of a recurring invoice schedule
model RecurringInvoiceRun {
  id                  String    @id @default(cuid())
  recurringInvoiceId  String
  businessId          String
  scheduledFor        DateTime // the original due date
  ranAt               DateTime  @default(now())
  status              String // SUCCESS|SUCCESS_PARTIAL|FAILED|SKIPPED
  generatedDocumentId String?   @unique
  paymentLinkId       String?
  idempotencyKey      String // {recurringId}_{scheduledFor_YYYYMMDD}
  errorMessage        String?   @db.VarChar(500)
  warning             String?   @db.VarChar(120) // autoSend_skipped_no_phone, paymentLink_failed, gstin_mismatch, …
  retryCount          Int       @default(0)
  triggeredBy         String // "cron" | userId
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())

  recurringInvoice  RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  generatedDocument Document?        @relation("RecurringRunDocument", fields: [generatedDocumentId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([recurringInvoiceId, ranAt(sort: Desc)])
  @@index([businessId, status])
  @@index([scheduledFor, status])
}

// ---------------------------------------------------------------------------
// Multi-Currency — Phase 2E
// ---------------------------------------------------------------------------

model ExchangeRate {
  id            String   @id @default(cuid())
  businessId    String
  fromCurrency  String   @db.VarChar(3)
  toCurrency    String   @default("INR") @db.VarChar(3)
  rate          Int // rate * 10000 (e.g., 1 USD = 84.5678 INR → 845678)
  effectiveDate DateTime
  source        String   @default("MANUAL") // MANUAL, API
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, fromCurrency, toCurrency, effectiveDate])
  @@index([businessId, fromCurrency, effectiveDate])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 3 — Accounting & Finance
// ═══════════════════════════════════════════════════════════════════════════════

/// Ledger Account — Chart of Accounts node
/// Every account belongs to one of: ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
/// Sub-types give finer classification (BANK, CASH, RECEIVABLE, PAYABLE, etc.)
model LedgerAccount {
  id            String    @id @default(cuid())
  businessId    String
  code          String // "1000", "2000", etc. — user-visible account code
  name          String // "Cash in Hand", "Sales", "HDFC Current A/c"
  type          String // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  subType       String? // BANK, CASH, RECEIVABLE, PAYABLE, TAX, INVENTORY, FIXED_ASSET, CAPITAL, REVENUE, PURCHASE, DIRECT_EXPENSE, INDIRECT_EXPENSE, LOAN
  parentId      String? // For tree hierarchy
  description   String?
  isSystem      Boolean   @default(false) // System-created (cannot delete)
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  // Running balance (paise) — updated on each journal entry post
  // Positive = debit-normal for ASSET/EXPENSE, credit-normal for LIABILITY/EQUITY/INCOME
  balance       Int       @default(0)
  // Link to bank account (if subType=BANK)
  bankAccountId String?   @unique
  // Link to party (if subType=RECEIVABLE or PAYABLE)
  partyId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent       LedgerAccount?     @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     LedgerAccount[]    @relation("AccountHierarchy")
  bankAccount  BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  journalLines JournalEntryLine[]

  @@unique([businessId, code])
  @@index([businessId, type, isActive])
  @@index([businessId, subType])
  @@index([businessId, isDeleted])
  @@index([parentId])
  @@index([partyId])
}

/// Journal Entry — the atomic unit of double-entry accounting
/// Every financial event (invoice, payment, expense, adjustment) creates one
model JournalEntry {
  id           String    @id @default(cuid())
  businessId   String
  entryNumber  String // Auto-generated: "JE-2526-001"
  date         DateTime
  narration    String?   @db.Text
  type         String // SALES, PURCHASE, RECEIPT, PAYMENT, CONTRA, JOURNAL, EXPENSE, CREDIT_NOTE, DEBIT_NOTE, OPENING
  status       String    @default("DRAFT") // DRAFT, POSTED, VOID
  // Source reference — what created this entry
  sourceType   String? // DOCUMENT, PAYMENT, EXPENSE, MANUAL, OPENING, FY_CLOSURE
  sourceId     String? // ID of the source record
  sourceNumber String? // Human-readable ref (INV-2526-001, PAY-001)
  // Totals (paise) — must be equal for valid entry
  totalDebit   Int       @default(0)
  totalCredit  Int       @default(0)
  // Void info
  voidedAt     DateTime?
  voidedBy     String?
  voidReason   String?
  // Audit
  createdBy    String
  postedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines    JournalEntryLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId, date])
  @@index([businessId, type])
  @@index([businessId, status])
  @@index([sourceType, sourceId])
}

/// Journal Entry Line — individual debit or credit within an entry
model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Int      @default(0) // paise — one of debit/credit must be > 0
  credit         Int      @default(0) // paise
  narration      String? // Line-level note
  partyId        String? // For receivable/payable tracking
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([partyId])
}

/// Bank Account — linked to a LedgerAccount with subType=BANK
model BankAccount {
  id             String    @id @default(cuid())
  businessId     String
  bankName       String
  accountNumber  String
  ifscCode       String?
  branchName     String?
  accountType    String    @default("CURRENT") // CURRENT, SAVINGS, OD, CC
  openingBalance Int       @default(0) // paise
  currentBalance Int       @default(0) // paise (updated on transactions)
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount?
  cheques       Cheque[]

  // Phase 7 — Bank reconciliation (#147)
  statementImports BankStatementImport[]

  @@unique([businessId, accountNumber])
  @@index([businessId, isActive])
  @@index([businessId, isDeleted])
}

/// Expense record — with category, receipt, and journal entry auto-posting
model Expense {
  id              String    @id @default(cuid())
  businessId      String
  categoryId      String
  amount          Int // paise
  date            DateTime
  paymentMode     String // CASH, UPI, BANK_TRANSFER, CHEQUE, CREDIT_CARD, OTHER
  bankAccountId   String? // if paid from bank
  partyId         String? // vendor/supplier
  referenceNumber String?   @db.VarChar(100)
  notes           String?   @db.Text
  receiptUrl      String? // attached receipt image
  isRecurring     Boolean   @default(false)
  // GST on expense
  gstApplicable   Boolean   @default(false)
  gstRate         Int       @default(0) // basis points
  gstAmount       Int       @default(0) // paise
  // Journal entry link
  journalEntryId  String?   @unique
  // Soft delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Expense lifecycle — status NOT NULL after PR2 backfill + constraint migration
  status        ExpenseStatus
  templateId    String? // FK to ExpenseTemplate
  confirmedAt   DateTime?
  skippedAt     DateTime?
  ocrSourceHash String?       @db.VarChar(64) // SHA-256 hex of OCR'd receipt bytes

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser User             @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  template      ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([businessId, date])
  @@index([businessId, categoryId])
  @@index([businessId, isDeleted])
  @@index([businessId, isDeleted, paymentMode])
  @@index([businessId, status, isDeleted])
  @@index([businessId, templateId])
}

/// Expense Category — user-configurable with system defaults
model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String
  icon       String? // emoji or icon name
  color      String    @default("#6B7280")
  isSystem   Boolean   @default(false) // Rent, Salary, Utilities, etc.
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses         Expense[]
  expenseTemplates ExpenseTemplate[]
  expenseBudgets   ExpenseBudget[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, isDeleted])
}

/// Recurring expense template — generates a PENDING_CONFIRMATION Expense row each period
model ExpenseTemplate {
  id          String           @id @default(cuid())
  businessId  String
  categoryId  String
  amountPaise Int // paise
  frequency   ExpenseFrequency
  dayOfMonth  Int? // 1-28 (clamped in service for MONTHLY/YEARLY)
  dayOfWeek   Int? // 0=Sun .. 6=Sat (WEEKLY)
  nextRunDate DateTime
  lastRunDate DateTime?
  paymentMode String // CASH, UPI, BANK_TRANSFER, CHEQUE, CREDIT_CARD, OTHER
  partyId     String? // vendor/supplier
  note        String?          @db.Text
  isActive    Boolean          @default(true)
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser User            @relation("ExpenseTemplateCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  expenses      Expense[]

  @@index([businessId, isActive, nextRunDate])
  @@index([businessId, categoryId])
}

/// Monthly expense budget — advisory only; per-category or overall (null categoryId)
model ExpenseBudget {
  id          String    @id @default(cuid())
  businessId  String
  categoryId  String? // null = overall budget across all categories
  monthYmd    String    @db.VarChar(10) // YYYY-MM-01
  amountPaise Int // paise
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser User             @relation("ExpenseBudgetCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([businessId, categoryId, monthYmd])
  @@index([businessId, monthYmd])
}

/// Other Income — interest, rent, misc income that's not from sales
model OtherIncome {
  id              String    @id @default(cuid())
  businessId      String
  category        String // INTEREST, RENT, COMMISSION, DISCOUNT_RECEIVED, MISCELLANEOUS
  amount          Int // paise
  date            DateTime
  paymentMode     String // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  bankAccountId   String?
  partyId         String?
  referenceNumber String?   @db.VarChar(100)
  notes           String?   @db.Text
  journalEntryId  String?   @unique
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("OtherIncomeCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([businessId, date])
  @@index([businessId, category])
  @@index([businessId, isDeleted])
}

/// Cheque — issued or received, with clearance tracking
model Cheque {
  id              String    @id @default(cuid())
  businessId      String
  type            String // ISSUED, RECEIVED
  chequeNumber    String
  bankAccountId   String
  partyId         String?
  amount          Int // paise
  date            DateTime // cheque date
  status          String    @default("PENDING") // PENDING, CLEARED, BOUNCED, CANCELLED, RETURNED
  clearanceDate   DateTime?
  bouncedAt       DateTime?
  bounceCharges   Int       @default(0) // paise
  bounceReason    String?
  referenceNumber String?   @db.VarChar(100)
  notes           String?
  journalEntryId  String?   @unique
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([businessId, type])
  @@index([businessId, date])
  @@index([businessId, isDeleted])
  @@index([bankAccountId])
}

/// Loan Account — track loans given/taken with EMI and interest
model LoanAccount {
  id                String    @id @default(cuid())
  businessId        String
  type              String // LOAN_GIVEN, LOAN_TAKEN
  partyId           String?
  loanName          String
  principalAmount   Int // paise
  interestRate      Int       @default(0) // basis points annual (1200 = 12%)
  tenure            Int? // months
  emiAmount         Int? // paise (monthly EMI)
  startDate         DateTime
  endDate           DateTime?
  outstandingAmount Int       @default(0) // paise — remaining principal
  totalInterestPaid Int       @default(0) // paise
  status            String    @default("ACTIVE") // ACTIVE, CLOSED, DEFAULTED
  journalEntryId    String?   @unique // opening entry
  notes             String?   @db.Text
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions LoanTransaction[]

  @@index([businessId, type, status])
  @@index([businessId, isDeleted])
}

/// Loan Transaction — EMI payment, interest charge, prepayment
model LoanTransaction {
  id              String   @id @default(cuid())
  loanAccountId   String
  type            String // EMI, INTEREST, PREPAYMENT, DISBURSEMENT, CLOSURE
  amount          Int // paise (total)
  principalAmount Int      @default(0) // paise (principal portion)
  interestAmount  Int      @default(0) // paise (interest portion)
  date            DateTime
  journalEntryId  String?  @unique
  notes           String?
  createdAt       DateTime @default(now())

  loanAccount LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)

  @@index([loanAccountId, date])
}

/// Financial Year Closure record
model FinancialYearClosure {
  id               String   @id @default(cuid())
  businessId       String
  financialYear    String // "2526" = April 2025 – March 2026
  closedAt         DateTime
  closedBy         String
  retainedEarnings Int      @default(0) // paise — P&L carried to Balance Sheet
  journalEntryId   String?  @unique // closing entry
  status           String   @default("CLOSED") // CLOSED, REOPENED
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, financialYear])
}

// === Coupon / Discount Code System — Feature #96 ===

/// Platform-level coupon for HisaabPro subscriptions
model Coupon {
  id                String          @id @default(cuid())
  code              String          @unique
  description       String?
  discountType      DiscountType
  discountValue     Int // Basis points for PERCENTAGE (2000 = 20%), paise for FIXED
  maxUses           Int? // null = unlimited
  usageCount        Int             @default(0)
  maxUsesPerUser    Int             @default(1)
  minPurchaseAmount Int? // paise, nullable
  validFrom         DateTime
  validUntil        DateTime? // null = no expiry
  isActive          Boolean         @default(true)
  appliesTo         CouponAppliesTo
  planFilter        String[]        @default([]) // Plan IDs, empty = all plans
  razorpayOfferId   String? // Linked Razorpay offer, null until synced
  metadata          Json            @default("{}")
  createdBy         String // AdminUser ID
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  creator     AdminUser          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  redemptions CouponRedemption[]

  @@index([isActive, validFrom, validUntil])
  @@index([code])
}

/// Tracks each coupon redemption by a user
model CouponRedemption {
  id                     String   @id @default(cuid())
  couponId               String
  userId                 String
  discountApplied        Int // paise — actual discount amount
  planId                 String? // Which plan was purchased
  razorpaySubscriptionId String? // Razorpay sub ID
  redeemedAt             DateTime @default(now())
  metadata               Json     @default("{}")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
}

// === WebAuthn / Biometric Auth — Feature #59 ===

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique // base64url-encoded credential ID from browser
  publicKey    String // base64url-encoded SPKI public key
  algorithm    Int // COSE algorithm ID: -7 (ES256) or -257 (RS256)
  signCount    Int       @default(0)
  deviceName   String? // e.g., "Pixel 8", "iPhone 15"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === Stock Alerts — Feature #47 ===

model StockAlert {
  id             String    @id @default(cuid())
  businessId     String
  productId      String
  alertType      String    @default("LOW_STOCK") // LOW_STOCK, OUT_OF_STOCK, EXPIRY_NEAR, EXPIRY_PASSED
  threshold      Float // quantity that triggered the alert
  currentQty     Float // quantity at time of alert
  status         String    @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  // Phase 2.2 — link to a specific batch for EXPIRY_NEAR / EXPIRY_PASSED rows
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([productId, status])
  @@index([businessId, batchId, alertType, status]) // cron dedupe + auto-resolve
}

// === Stock Verification — Feature #111 ===

model StockVerification {
  id          String    @id @default(cuid())
  businessId  String
  verifiedBy  String
  status      String    @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, FINALIZED
  notes       String?
  completedAt DateTime?
  finalizedAt DateTime?
  finalizedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User                    @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)
  items    StockVerificationItem[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model StockVerificationItem {
  id             String  @id @default(cuid())
  verificationId String
  productId      String
  systemQuantity Float // what the system says (at time of snapshot)
  actualQuantity Float? // what was physically counted
  discrepancy    Float? // actualQuantity - systemQuantity
  adjusted       Boolean @default(false)
  notes          String?

  // Phase 2.2 — optional batch reference (null = product-level count)
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  verification StockVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([verificationId])
  @@index([productId])
  @@index([batchId])
}

// === Phase 4 — Serial Number Tracking (#100) ===

model SerialNumber {
  id               String    @id @default(cuid())
  businessId       String
  productId        String
  serialNumber     String
  status           String    @default("AVAILABLE") // AVAILABLE, SOLD, RETURNED, DAMAGED, WARRANTY
  batchId          String?
  godownId         String?
  soldInDocumentId String?
  soldAt           DateTime?
  notes            String?
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  godown         Godown?   @relation(fields: [godownId], references: [id], onDelete: SetNull)
  soldInDocument Document? @relation(fields: [soldInDocumentId], references: [id], onDelete: SetNull)

  @@unique([businessId, serialNumber])
  @@index([businessId, productId, status])
  @@index([businessId, status])
  @@index([businessId, isDeleted])
  @@index([productId])
  @@index([soldInDocumentId])
}

// === Phase 4 — Batch Tracking (#99 Batch Tracking + #105 Expiry Alerts) ===

model Batch {
  id                String    @id @default(cuid())
  businessId        String
  productId         String
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  costPrice         Int? // paise
  salePrice         Int? // paise — batch-specific override
  currentStock      Float     @default(0)
  notes             String?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements    StockMovement[]
  godownStocks      GodownStock[]
  godownTransfers   GodownTransfer[]
  serialNumbers     SerialNumber[]
  stockAlerts       StockAlert[] // Phase 2.2 — expiry alerts linked to this batch
  verificationItems StockVerificationItem[] // Phase 2.2 — per-batch verification counts
  posSaleItems      PosSaleItem[] // Phase 4 — POS Billing

  @@unique([businessId, productId, batchNumber])
  @@index([businessId, productId])
  @@index([businessId, expiryDate])
  @@index([productId, isDeleted])
  @@index([productId, expiryDate]) // FEFO selection — mirrors Batch_productId_expiryDate_idx CONCURRENTLY index
}

// === Phase 4 — Multi-Godown (#101 Multi-Godown) ===

model Godown {
  id         String    @id @default(cuid())
  businessId String
  name       String
  address    String?
  isDefault  Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockLocations GodownStock[]
  stockMovements StockMovement[]
  transfersFrom  GodownTransfer[] @relation("TransferFrom")
  transfersTo    GodownTransfer[] @relation("TransferTo")
  serialNumbers  SerialNumber[]
  posSaleItems   PosSaleItem[] // Phase 4 — POS Billing

  @@unique([businessId, name])
  @@index([businessId, isDeleted])
}

model GodownStock {
  id         String  @id @default(cuid())
  businessId String
  productId  String
  godownId   String
  batchId    String?
  quantity   Float   @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  godown   Godown   @relation(fields: [godownId], references: [id], onDelete: Restrict)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([productId, godownId, batchId])
  @@index([businessId, godownId])
  @@index([productId, godownId])
}

model GodownTransfer {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  batchId       String?
  fromGodownId  String
  toGodownId    String
  quantity      Int
  notes         String?
  transferredBy String
  createdAt     DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch      Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  fromGodown Godown   @relation("TransferFrom", fields: [fromGodownId], references: [id], onDelete: Restrict)
  toGodown   Godown   @relation("TransferTo", fields: [toGodownId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [transferredBy], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([productId])
  @@index([fromGodownId])
  @@index([toGodownId])
}

// === Subscription — Feature: plan gating ===

model Subscription {
  id             String    @id @default(cuid())
  businessId     String    @unique
  planTier       String    @default("FREE") // FREE, PRO, BUSINESS, PRO_MAX
  status         String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, TRIALING
  startDate      DateTime  @default(now())
  expiresAt      DateTime?
  razorpaySubId  String? // Razorpay subscription ID
  razorpayPlanId String? // Razorpay plan ID
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // --- subscription-port columns (Step 3: NOT NULL where backfilled) ---
  subscriptionState       String    @default("NONE") // NONE | PROMO_ACTIVE | TRIAL_NO_AUTOPAY | ACTIVE | PAST_DUE | LOCKED | CANCELLED
  mandateId               String? // FK to UpiMandate.id (added after UpiMandate table exists)
  gracePeriodEndsAt       DateTime?
  trialEndsAt             DateTime?
  autoRenew               Boolean   @default(false)
  nextBillingAt           DateTime?
  paymentMethod           String    @default("MANUAL") // UPI_AUTOPAY | CARD | MANUAL | RAZORPAY
  lastEntitlementIssuedAt DateTime?
  pendingDowngradeTier    String? // scheduled downgrade target tier
  overflowGraceUntil      DateTime? // when overflow grace period ends
  lastWebhookEventId      String? // last Razorpay event ID processed

  business           Business            @relation(fields: [businessId], references: [id])
  subscriptionEvents SubscriptionEvent[]
  upiMandates        UpiMandate[]

  @@index([businessId])
  @@index([status])
  @@index([subscriptionState])
  @@index([nextBillingAt])
  @@index([gracePeriodEndsAt])
}

// === subscription-port — New tables (Step 5) ===

/// Immutable audit ledger for all subscription state transitions.
model SubscriptionEvent {
  id              String   @id @default(cuid())
  businessId      String
  subscriptionId  String
  eventType       String // CHECKOUT | ACTIVATE | RENEW | CANCEL | REACTIVATE | TRIAL_START | TRIAL_END | ADMIN_GRANT | MANDATE_CREATE | MANDATE_REVOKE | ADDON_PURCHASE | ADDON_REVOKE | STATE_TRANSITION | OVERFLOW_ENTER | OVERFLOW_EXIT
  fromState       String?
  toState         String?
  payload         Json     @default("{}")
  razorpayEventId String?  @unique // IDEMPOTENCY KEY — sparse unique (nullable)
  actorUserId     String? // for admin actions
  actorType       String // USER | SYSTEM | WEBHOOK | ADMIN | CRON
  createdAt       DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([eventType])
}

/// Catalog of optional feature add-ons that businesses can purchase.
model FeatureAddon {
  id                String   @id @default(cuid())
  code              String   @unique
  displayName       String
  description       String?
  priceMonthlyPaise Int
  priceYearlyPaise  Int?
  razorpayPlanId    String?
  requiresPlanTier  String? // gate by base plan (e.g. 'PRO')
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businessAddons BusinessAddon[]
}

/// Join table: which businesses have purchased which add-ons.
model BusinessAddon {
  id             String    @id @default(cuid())
  businessId     String
  featureAddonId String
  startDate      DateTime
  endDate        DateTime?
  status         String    @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  razorpaySubId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  featureAddon FeatureAddon @relation(fields: [featureAddonId], references: [id], onDelete: Restrict)

  @@unique([businessId, featureAddonId, startDate])
  @@index([businessId, status])
}

/// UPI Autopay mandate records.
model UpiMandate {
  id                String    @id @default(cuid())
  businessId        String
  subscriptionId    String
  razorpayMandateId String?   @unique
  razorpayTokenId   String?
  status            String    @default("PENDING") // PENDING | ACTIVE | PAUSED | REVOKED | FAILED
  maxAmountPaise    Int
  frequency         String // MONTHLY | YEARLY
  nextChargeAt      DateTime?
  lastChargeAt      DateTime?
  vpaLast4          String? // masked — last 4 chars of VPA only, never full VPA
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([status, nextChargeAt])
}

// ─── Business-Verticals Phase 3 — Jobs (services vertical) ────────────────────

enum JobStatus {
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  CANCELLED
}

// V1 hourly billing — distinguishes a generic line from an hours-billed line.
// HOURLY reuses quantity (= hours) and ratePaise (= rate/hour); math is identical.
enum JobItemKind {
  ITEM
  HOURLY
}

model Job {
  id         String @id @default(cuid())
  businessId String
  partyId    String

  // Numbering — assigned on first SAVE (status leaves QUOTED). Independent series: "JOB-25-26-0001".
  jobNumber      String?
  sequenceNumber Int?
  financialYear  String?

  // Content
  title       String    @db.VarChar(200)
  description String?   @db.Text
  status      JobStatus @default(QUOTED)

  // Schedule
  scheduledAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(500)

  // V1 hourly billing — estimate vs actual tracking. Informational only; never
  // summed into money totals (those stay line-driven). Fractional hours allowed.
  estimatedHours Decimal? @db.Decimal(10, 2)
  actualHours    Decimal? @db.Decimal(10, 2)

  // Totals (PAISE — integer, matches Document)
  subtotalPaise Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  // Forward link to the SALE_INVOICE produced by convert-to-invoice
  invoiceId String? @unique

  // Offline sync (matches Document.clientId pattern)
  clientId String? @unique

  // Soft delete (matches Document/Party convention)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Audit
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice  Document? @relation("JobInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  items    JobItem[]

  @@unique([businessId, jobNumber])
  @@index([businessId, status])
  @@index([businessId, partyId])
  @@index([businessId, scheduledAt])
  @@index([businessId, isDeleted])
  @@index([clientId])
}

model JobItem {
  id        String @id @default(cuid())
  jobId     String
  sortOrder Int    @default(0)

  // Optional product link — services often have no SKU.
  productId String?

  // V1 hourly billing — ITEM (generic) or HOURLY (quantity = hours, ratePaise = rate/hour).
  kind JobItemKind @default(ITEM)

  description String @db.VarChar(500)

  // Quantity matches HP convention: Decimal(12,3) for fractional units (hours, kg).
  quantity Decimal @db.Decimal(12, 3)

  // Money — PAISE integers, matches DocumentLineItem.
  ratePaise     Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product Product? @relation("JobItemProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([productId])
}

// ─── Business-Verticals Phase 4 — Custom Orders (bakery / tailor verticals) ────

enum CustomOrderStatus {
  RECEIVED // taken from customer; advance optional
  IN_PRODUCTION // shop has started work
  READY // ready for pickup / dispatch
  DELIVERED // handed over; not yet billed
  INVOICED // converted to a SALE_INVOICE Document
  CANCELLED
}

model CustomOrder {
  id         String @id @default(cuid())
  businessId String
  partyId    String

  // Numbering — assigned on create. Independent series: "ORD-25-26-0001".
  orderNumber    String?
  sequenceNumber Int?
  financialYear  String?

  // Content
  title  String            @db.VarChar(200)
  notes  String?           @db.Text
  status CustomOrderStatus @default(RECEIVED)

  // Delivery
  deliveryAt      DateTime?
  deliverySlot    String?   @db.VarChar(40)
  deliveryAddress String?   @db.VarChar(500)
  deliveredAt     DateTime?

  // Lifecycle audit timestamps
  productionStartedAt DateTime?
  readyAt             DateTime?
  cancelledAt         DateTime?
  cancelReason        String?   @db.VarChar(500)

  // Totals (PAISE — Int, matches Document/Job)
  subtotalPaise Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  // Advance — denormalised sum of CustomOrderAdvance rows
  advancePaise Int @default(0)

  // balancePaise = totalPaise - advancePaise. Persisted for queryability.
  balancePaise Int @default(0)

  // Forward link to the SALE_INVOICE produced by convert-to-invoice
  invoiceId String? @unique

  // Offline sync (matches Document.clientId / Job.clientId pattern)
  clientId String? @unique

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Audit
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party    Party                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice  Document?            @relation("CustomOrderInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  items    CustomOrderItem[]
  advances CustomOrderAdvance[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@index([businessId, partyId])
  @@index([businessId, deliveryAt])
  @@index([businessId, isDeleted])
  @@index([clientId])
}

model CustomOrderItem {
  id            String @id @default(cuid())
  customOrderId String
  sortOrder     Int    @default(0)

  // Optional product link — bakery/tailor items often have no SKU.
  productId String?

  description String @db.VarChar(500)

  // Per-item spec JSON (free-form, driven by CustomFieldDefinition rows)
  spec Json?

  // Quantity: Decimal(12,3) for fractional units
  quantity Decimal @db.Decimal(12, 3)

  // Money — PAISE Int
  ratePaise     Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  product     Product?    @relation("CustomOrderItemProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([customOrderId])
  @@index([productId])
}

model CustomOrderAdvance {
  id            String @id @default(cuid())
  customOrderId String

  // Money received against this order before the invoice exists
  amountPaise Int

  // Payment method — string to avoid enum coupling; validated in Zod
  method     String   @db.VarChar(40)
  reference  String?  @db.VarChar(120)
  receivedAt DateTime @default(now())
  notes      String?  @db.VarChar(500)

  // Stamped with the Payment.id when the order converts to invoice
  paymentId String?

  // Audit
  createdBy String
  createdAt DateTime @default(now())

  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Cash Register — Phase 1
// ═══════════════════════════════════════════════════════════════════════════════

enum CashEntryDirection {
  IN
  OUT
}

enum CashEntryEventType {
  CREATED
  EDITED
  VOIDED
  RESTORED
  HARD_DELETED
}

// ═══════════════════════════════════════════════════════════════════════════════
// Expenses Upgrade — PR1 enums
// ═══════════════════════════════════════════════════════════════════════════════

enum ExpenseStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  SKIPPED
  VOIDED
}

enum ExpenseFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model CashEntry {
  id              String             @id @default(cuid())
  businessId      String
  expression      String // raw expression e.g. "100+50*2"
  amountPaise     BigInt // server-evaluated, never client-trusted
  direction       CashEntryDirection
  note            String?
  createdBy       String // BusinessUser.id
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  voidedAt        DateTime?
  voidedBy        String? // BusinessUser.id
  voidReason      String?
  idempotencyKey  String? // X-Idempotency-Key header value
  ledgerJournalId String? // Phase 2: link to JournalEntry

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   CashEntryEvent[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, voidedAt])
  @@index([businessId, direction, createdAt(sort: Desc)])
  @@map("cash_entries")
}

model CashEntryEvent {
  id          String             @id @default(cuid())
  cashEntryId String
  eventType   CashEntryEventType
  actorId     String // BusinessUser.id
  changes     Json? // before/after diff for EDITED
  reason      String? // for VOIDED
  createdAt   DateTime           @default(now())

  cashEntry CashEntry @relation(fields: [cashEntryId], references: [id], onDelete: Cascade)

  @@index([cashEntryId, createdAt])
  @@map("cash_entry_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PR 4 — Webhook Event Deduplication (MB-1)
// ═══════════════════════════════════════════════════════════════════════════════

/// Idempotency store for inbound webhooks.
/// INSERT before processing; ON CONFLICT DO NOTHING; if 0 rows → replay.
model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  source      String?  @db.VarChar(20)
  payload     Json?
  processedAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════════
// Notifications Engine — PR1 (schema: 5 models + 3 enums + 9 indexes)
// Migration: notifications_init (additive only — no DROP, no NOT NULL backfill)
// ═══════════════════════════════════════════════════════════════════════════════

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
  WHATSAPP
}

enum NotificationJobStatus {
  QUEUED
  PROCESSING
  DISPATCHED
  DELIVERED
  FAILED
  DEAD
}

enum NotificationDeliveryStatus {
  UNKNOWN
  DELIVERED
  BOUNCED
  REJECTED
  EXPIRED
}

model Notification {
  id         String @id @default(cuid())
  businessId String
  userId     String

  eventKey String @db.VarChar(60)
  titleEn  String @db.VarChar(160)
  titleHi  String @db.VarChar(160)
  bodyEn   String @db.Text
  bodyHi   String @db.Text

  isRead Boolean   @default(false)
  readAt DateTime?

  entityType  String? @db.VarChar(40)
  entityId    String?
  deepLinkUrl String? @db.VarChar(255)

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, isRead, createdAt(sort: Desc)])
  @@index([businessId, userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model NotificationJob {
  id         String @id @default(cuid())
  businessId String
  userId     String

  eventKey       String                     @db.VarChar(60)
  channel        NotificationChannel
  status         NotificationJobStatus      @default(QUEUED)
  deliveryStatus NotificationDeliveryStatus @default(UNKNOWN)

  idempotencyKey String @unique @db.VarChar(40)

  // PII separation — §3.1: no raw phone/email/token in payload
  recipientChannel NotificationChannel
  pushTokenId      String? // FK to PushToken (PUSH only)
  recipientHash    String              @db.VarChar(64) // sha256 of recipient identifier; never raw

  payload    Json // RENDERED ONLY: { title, body, deepLinkUrl, vars }
  externalId String? @db.VarChar(120)

  scheduledAt   DateTime  @default(now())
  claimedAt     DateTime?
  claimedBy     String?   @db.VarChar(80)
  processedAt   DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureCode   String?   @db.VarChar(60)
  failureReason String?   @db.VarChar(500)
  retryCount    Int       @default(0)

  costPaise Int @default(0)

  createdAt DateTime @default(now())

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pushToken PushToken? @relation(fields: [pushTokenId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([businessId, status, createdAt])
  @@index([externalId])
  @@index([userId, createdAt])
  @@index([recipientHash, createdAt])
  @@index([createdAt])
}

model NotificationPreference {
  id         String              @id @default(cuid())
  businessId String
  userId     String
  eventKey   String              @db.VarChar(60)
  channel    NotificationChannel
  enabled    Boolean             @default(true)

  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, eventKey, channel])
  @@index([businessId, userId])
}

model NotificationCostTally {
  id         String              @id @default(cuid())
  businessId String
  month      String              @db.VarChar(7) // "2026-05" IST
  channel    NotificationChannel
  totalPaise Int                 @default(0)
  sentCount  Int                 @default(0)
  updatedAt  DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, month, channel])
  @@index([businessId, month])
}

model PushToken {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  token      String   @db.VarChar(255)
  platform   String   @db.VarChar(20) // 'android' | 'ios' | 'web'
  appVersion String?  @db.VarChar(40)
  lastSeenAt DateTime @default(now())
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  notificationJobs NotificationJob[]

  @@unique([userId, token])
  @@index([businessId, userId, isValid])
}

// === Phase 4 — POS Billing Mode (#118) ===

model PosSale {
  id            String @id @default(cuid())
  businessId    String
  documentId    String @unique // FK to Document(type=POS_SALE)
  receiptNumber String // "POS25-26-00001"
  receiptSeq    Int // raw counter for ORDER BY
  financialYear String // "25-26"

  partyId     String?
  walkInName  String? @db.VarChar(60)
  walkInPhone String? @db.VarChar(15)

  subtotal          Int @default(0)
  totalDiscount     Int @default(0)
  totalTaxableValue Int @default(0)
  totalCgst         Int @default(0)
  totalSgst         Int @default(0)
  totalIgst         Int @default(0)
  totalCess         Int @default(0)
  grandTotal        Int @default(0)

  taxPricingMode String  @default("EXCLUSIVE") @db.VarChar(20)
  placeOfSupply  String? @db.VarChar(2)
  supplyType     String  @default("B2C_SMALL") @db.VarChar(20)

  paymentBreakdown Json @default("[]") // [{mode, amountPaise, referenceNumber, note}]

  cashierId String // BusinessUser.userId

  status     String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | VOIDED
  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?   @db.VarChar(200)
  restoredAt DateTime?
  restoredBy String?

  idempotencyKey String  @unique
  clientId       String? @unique

  saleDate  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  party       Party?         @relation(fields: [partyId], references: [id], onDelete: SetNull)
  cashier     User           @relation("PosCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  voidUser    User?          @relation("PosVoider", fields: [voidedBy], references: [id])
  restoreUser User?          @relation("PosRestorer", fields: [restoredBy], references: [id])
  items       PosSaleItem[]
  events      PosSaleEvent[]

  // Phase 5 Epic D — Loyalty #125 + Commission #128 reverse
  loyaltyLedger    LoyaltyLedger[]
  commissionLedger CommissionLedger[]

  @@unique([businessId, receiptNumber])
  @@index([businessId, saleDate])
  @@index([businessId, status])
  @@index([businessId, cashierId])
  @@index([businessId, partyId])
  @@index([businessId, financialYear, receiptSeq])
}

model PosSaleItem {
  id        String @id @default(cuid())
  posSaleId String
  sortOrder Int    @default(0)

  productId   String
  productName String  @db.VarChar(200)
  sku         String? @db.VarChar(60)
  hsnCode     String? @db.VarChar(10)
  unitSymbol  String  @db.VarChar(20)

  quantity       Float
  ratePaise      Int
  discountType   String @default("AMOUNT") @db.VarChar(20)
  discountValue  Int    @default(0)
  discountAmount Int    @default(0)
  lineTotal      Int    @default(0)

  taxableValue Int @default(0)
  cgstRate     Int @default(0)
  cgstAmount   Int @default(0)
  sgstRate     Int @default(0)
  sgstAmount   Int @default(0)
  igstRate     Int @default(0)
  igstAmount   Int @default(0)
  cessRate     Int @default(0)
  cessAmount   Int @default(0)

  batchId     String?
  batchNumber String? @db.VarChar(60)
  godownId    String?

  note String? @db.VarChar(120)

  posSale PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  godown  Godown? @relation(fields: [godownId], references: [id], onDelete: SetNull)

  @@index([posSaleId])
  @@index([productId])
  @@index([batchId])
}

model PosReceiptCounter {
  id            String   @id @default(cuid())
  businessId    String
  financialYear String // "25-26"
  prefix        String   @default("POS")
  separator     String   @default("-")
  paddingDigits Int      @default(5)
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, financialYear])
  @@index([businessId])
}

model PosSaleEvent {
  id        String   @id @default(cuid())
  posSaleId String
  type      String   @db.VarChar(40) // CREATED | VOIDED | RESTORED | RECEIPT_SHARED
  actorId   String?
  payload   Json?
  createdAt DateTime @default(now())

  posSale PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([posSaleId, createdAt])
  @@index([posSaleId, type])
}

model PosSetting {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  receiptPrefix          String   @default("POS")
  receiptSeparator       String   @default("-")
  receiptPaddingDigits   Int      @default(5)
  defaultPaymentMode     String   @default("CASH") @db.VarChar(20)
  voidWindowHours        Int      @default(24)
  defaultThermalWidth    String   @default("58MM") @db.VarChar(8)
  autoShareOnCheckout    Boolean  @default(false)
  autoShareChannel       String   @default("WHATSAPP") @db.VarChar(20)
  showProfitOnGrid       Boolean  @default(false)
  cashierMustSelectParty Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// === Phase 4 — BOM / Manufacturing (#115) ===

model Bom {
  id         String   @id @default(cuid())
  businessId String
  productId  String // finished good
  name       String   @db.VarChar(100)
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  notes      String?  @db.Text
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  updatedBy  String?

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product         @relation("BomFinishedGood", fields: [productId], references: [id], onDelete: Restrict)
  createdByUser  User            @relation("BomCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  components     BomComponent[]
  productionRuns ProductionRun[]

  @@unique([businessId, productId, version])
  @@index([businessId, productId])
  @@index([businessId, isDeleted])
}

model BomComponent {
  id                 String  @id @default(cuid())
  bomId              String
  componentProductId String
  quantity           Float // > 0; same Float convention as Product.currentStock
  unitId             String?
  notes              String?

  bom              Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("BomComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)
  unit             Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([bomId, componentProductId])
  @@index([bomId])
}

model ProductionRun {
  id                String   @id @default(cuid())
  businessId        String
  bomId             String
  finishedProductId String
  quantityProduced  Float
  runDate           DateTime
  status            String   @default("COMPLETED") // DRAFT | COMPLETED | CANCELLED
  notes             String?  @db.Text
  warnings          Json? // string[] — warn-only stock shortfalls
  isDeleted         Boolean  @default(false)
  createdBy         String
  createdAt         DateTime @default(now())

  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bom             Bom                      @relation(fields: [bomId], references: [id], onDelete: Restrict)
  finishedProduct Product                  @relation("ProductionRunFinished", fields: [finishedProductId], references: [id], onDelete: Restrict)
  createdByUser   User                     @relation("ProductionRunCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  components      ProductionRunComponent[]

  @@index([businessId, runDate])
  @@index([businessId, status])
  @@index([businessId, isDeleted])
}

model ProductionRunComponent {
  id                 String @id @default(cuid())
  productionRunId    String
  componentProductId String
  quantityConsumed   Float
  costSnapshotPaise  BigInt @default(0) // weightedAvgCostPaise at run time

  productionRun    ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  componentProduct Product       @relation("ProductionRunComponents", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@index([productionRunId])
}

// ============================================================
// Phase 5 — Marketing Communications Models
// ============================================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RecipientDispatchStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum ReminderRuleTrigger {
  BIRTHDAY
  PAYMENT_DUE
  PAYMENT_OVERDUE
  FOLLOWUP
  INACTIVE
  ORDER_DELIVERY
}

enum ReminderInstanceStatus {
  PENDING
  DISPATCHED
  FAILED
  SKIPPED
}

model MarketingTemplate {
  id               String    @id @default(cuid())
  businessId       String
  name             String    @db.VarChar(100)
  channel          String // WHATSAPP | SMS
  bodyEn           String    @db.Text
  bodyHi           String?   @db.Text
  dltTemplateId    String?   @db.VarChar(60)
  dltRegistered    Boolean   @default(false)
  waTemplateName   String?   @db.VarChar(80)
  waTemplateStatus String?   @default("PENDING")
  variables        String[]  @default([])
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns MarketingCampaign[]
  rules     ReminderRule[]

  @@unique([businessId, name, channel])
  @@index([businessId, channel, isActive])
  @@index([businessId, isDeleted])
}

model MarketingCampaign {
  id             String         @id @default(cuid())
  businessId     String
  name           String         @db.VarChar(100)
  channel        String // WHATSAPP | SMS
  templateId     String
  segmentFilter  Json           @default("{}")
  recipientCount Int            @default(0)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  status         CampaignStatus @default(DRAFT)
  sentCount      Int            @default(0)
  deliveredCount Int            @default(0)
  failedCount    Int            @default(0)
  totalCostPaise Int            @default(0)
  defaultVars    Json           @default("{}")
  isDeleted      Boolean        @default(false)
  deletedAt      DateTime?
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  business   Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template   MarketingTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients MarketingCampaignRecipient[]

  @@index([businessId, status, scheduledAt])
  @@index([businessId, isDeleted])
  @@index([businessId, createdAt])
}

model MarketingCampaignRecipient {
  id           String                  @id @default(cuid())
  campaignId   String
  partyId      String
  phone        String?                 @db.VarChar(20)
  status       RecipientDispatchStatus @default(QUEUED)
  jobId        String?
  skipReason   String?                 @db.VarChar(80)
  dispatchedAt DateTime?
  failedAt     DateTime?
  costPaise    Int                     @default(0)
  createdAt    DateTime                @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  party    Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([campaignId, partyId])
  @@index([campaignId, status])
  @@index([campaignId, createdAt])
}

model ReminderRule {
  id              String              @id @default(cuid())
  businessId      String
  name            String              @db.VarChar(100)
  trigger         ReminderRuleTrigger
  offsetDays      Int                 @default(0)
  channel         String // WHATSAPP | SMS
  templateId      String
  segmentFilter   Json                @default("{}")
  enabled         Boolean             @default(true)
  quietHoursStart String?             @db.VarChar(5)
  quietHoursEnd   String?             @db.VarChar(5)
  isDeleted       Boolean             @default(false)
  deletedAt       DateTime?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template  MarketingTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  instances ReminderInstance[]

  @@index([businessId, enabled])
  @@index([businessId, trigger, enabled])
  @@index([businessId, isDeleted])
}

model ReminderInstance {
  id           String                 @id @default(cuid())
  ruleId       String
  partyId      String
  fireDate     DateTime
  scheduledAt  DateTime
  status       ReminderInstanceStatus @default(PENDING)
  jobId        String?
  skipReason   String?                @db.VarChar(80)
  dispatchedAt DateTime?
  costPaise    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  rule  ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  party Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([ruleId, partyId, fireDate])
  @@index([status, scheduledAt])
  @@index([ruleId, status])
  @@index([partyId])
}

// Epic C — PR1: Opaque public-link tokens (hash at rest; plaintext NEVER stored)
model SharedLink {
  id             String    @id @default(cuid())
  tokenHash      String    @unique // sha256(32-byte opaque token) hex; plaintext never persisted
  resourceType   String // "INVOICE" | "INVITE" | "STORE"
  resourceId     String // cuid of invoice / party / etc.
  businessId     String
  issuedById     String
  expiresAt      DateTime?
  revokedAt      DateTime?
  claimedAt      DateTime? // one-shot links (INVITE) — set atomically on consume
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)
  metadata       Json? // per-resource extras (e.g. invoice number for display)
  createdAt      DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  issuedBy User     @relation(fields: [issuedById], references: [id])

  @@index([businessId, resourceType])
  @@index([resourceId])
}

// === Phase 5 Epic D — Loyalty #125 + CRM #127 + Commission #128 ===
// Architecture: docs/ARCHITECTURE_EPIC_D_crm_loyalty.md §2
// Migration:   prisma/migrations/20260518000000_phase5_epic_d_crm_loyalty_commission

model LoyaltyProgram {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  enabled                Boolean  @default(false)
  // Accrual — pointsEarned = floor(subtotalPaise * accrualRateBps / 1_000_000)
  accrualRateBps         Int      @default(100)
  accrualMinSpendPaise   Int      @default(0)
  // Redemption — amountPaise * redemptionUnit === loyaltyPoints * redemptionPaisePerUnit (BigInt math)
  redemptionUnit         Int      @default(1)
  redemptionPaisePerUnit Int      @default(100)
  // Expiry — null = never; default 12 months
  expiryMonths           Int?
  // Audit
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model LoyaltyLedger {
  id          String    @id @default(cuid())
  businessId  String
  partyId     String
  // AC | RD | EX | AD | VD | VR — see services/loyalty/loyalty.constants.ts
  type        String    @db.VarChar(20)
  delta       Int
  // Provenance — exactly one of these is set (enforced in service layer)
  posSaleId   String?
  documentId  String?
  expiryRunId String?
  adjustedBy  String?
  note        String?   @db.VarChar(200)
  earnedAt    DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  posSale  PosSale?  @relation(fields: [posSaleId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([businessId, partyId, createdAt])
  @@index([businessId, partyId, expiresAt])
  @@index([businessId, expiresAt])
  @@index([posSaleId])
  @@index([documentId])
}

model CommissionRule {
  id               String   @id @default(cuid())
  businessId       String
  name             String   @db.VarChar(80)
  // ALL | PRODUCT | CATEGORY
  scope            String   @db.VarChar(20)
  scopeId          String?
  // PERCENT_GROSS | PERCENT_NET | FLAT_PER_UNIT
  mode             String   @db.VarChar(30)
  // basis points (0..10000) for PERCENT modes; capped at Zod layer (v3 / S2)
  rateBps          Int?
  flatPerUnitPaise Int?
  // POS | INVOICE | BOTH
  appliesTo        String   @db.VarChar(10)
  // empty array = applies to ALL staff
  staffUserIds     String[] @default([])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@index([businessId, scope, scopeId])
}

model CommissionLedger {
  id              String   @id @default(cuid())
  businessId      String
  // BusinessUser.userId (FK → User.id)
  staffUserId     String
  // Nullable — preserved history when rule is deleted (SetNull)
  ruleId          String?
  posSaleId       String?
  documentId      String?
  basisPaise      Int
  // Signed paise — void/restore produce ±compensating rows (architecture §3.4.1)
  commissionPaise Int
  // "YYYY-MM" — denormalized for leaderboard speed
  periodYearMonth String   @db.VarChar(7)
  createdAt       DateTime @default(now())
  // { ruleSnapshot (DEEP CLONED — v3 / M1), source: 'POS'|'INVOICE'|'VOID'|'RESTORE', appliedAt }
  meta            Json?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    User      @relation("StaffCommissionLedger", fields: [staffUserId], references: [id], onDelete: Restrict)
  posSale  PosSale?  @relation(fields: [posSaleId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([businessId, staffUserId, periodYearMonth])
  @@index([businessId, periodYearMonth])
  @@index([posSaleId])
  @@index([documentId])
}

// ─── Phase 6 — Staff & HR (architecture §2.1) ───────────────────────────────

/// Employee — paired 1:1 with a STAFF Party (architecture §8.5). The
/// `partyId` link is created in the same $transaction as the Employee row;
/// neither can exist without the other. Payroll Payments carry
/// `partyId = <paired STAFF Party id>` so customer ledger queries can
/// exclude payroll naturally via `party.type != 'STAFF'`.
model Employee {
  id          String    @id @default(cuid())
  businessId  String
  /// Optional — set only if the employee also logs into HisaabPro as a User.
  userId      String?
  /// 1:1 paired STAFF Party (Party.type='STAFF'). `@unique` enforces the
  /// invariant that one Party row owns at most one Employee row.
  partyId     String    @unique
  name        String
  phone       String?
  designation String?
  /// Daily rate in paise — used by Payroll compute.
  dailyRate   Int
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user        User?             @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  party       Party             @relation("EmployeeParty", fields: [partyId], references: [id], onDelete: Restrict)
  creator     User              @relation("EmployeeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendances Attendance[]
  payrolls    Payroll[]
  advances    EmployeeAdvance[]

  @@unique([businessId, partyId])
  @@index([businessId, isDeleted])
  @@index([businessId, name])
}

/// Attendance — one row per Employee per date. Service-layer batch upserts
/// keep insert volume bounded.
model Attendance {
  id          String   @id @default(cuid())
  businessId  String
  employeeId  String
  date        DateTime @db.Date
  /// PRESENT | ABSENT | HALF_DAY | LEAVE_PAID | LEAVE_UNPAID
  status      String
  overtimeMin Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())
  createdById String

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  creator  User     @relation("AttendanceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([businessId, employeeId, date])
  @@index([businessId, date])
}

/// EmployeeAdvance — money paid up-front to an employee against future
/// payroll. Optional `paymentId` links back to the Payment row written when
/// the advance was disbursed (paymentId is nullable for legacy / manual entry
/// rows that were not coupled to a Payment).
model EmployeeAdvance {
  id          String    @id @default(cuid())
  businessId  String
  employeeId  String
  /// Paise — always positive; the payroll-compute layer subtracts it from net.
  amount      Int
  grantedAt   DateTime  @default(now())
  paidBackAt  DateTime?
  paymentId   String?
  note        String?
  createdAt   DateTime  @default(now())
  createdById String

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payment  Payment? @relation("AdvancePayment", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId, employeeId])
  @@index([businessId, paidBackAt])
}

/// PayrollRun — parent; state machine: DRAFT → FINALIZED → REVERSED (terminal).
/// `@@unique([businessId, fromDate, toDate])` enforces "no overlapping runs
/// for the same period" at the DB level (architecture §6.2
/// PAYROLL_PERIOD_OVERLAP 409).
model PayrollRun {
  id            String    @id @default(cuid())
  businessId    String
  fromDate      DateTime  @db.Date
  toDate        DateTime  @db.Date
  /// DRAFT | FINALIZED | REVERSED
  status        String    @default("DRAFT")
  /// Recomputed on FINALIZE; sum of all child Payroll.netPaise.
  totalNet      Int       @default(0)
  finalizedAt   DateTime?
  finalizedById String?
  createdAt     DateTime  @default(now())
  createdById   String

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  finalizer User?     @relation("PayrollRunFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  creator   User      @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payrolls  Payroll[]

  @@unique([businessId, fromDate, toDate])
  @@index([businessId, status])
}

/// Payroll — child; one row per Employee per PayrollRun.
/// Mirrors the PayrollRun state machine. `paymentId` links to the Payment
/// row written in the same $transaction as FINALIZE (nullable until then).
model Payroll {
  id                String   @id @default(cuid())
  businessId        String
  payrollRunId      String
  employeeId        String
  presentDays       Int
  halfDays          Int
  overtimeMin       Int
  advanceTotalPaise Int
  deductionsPaise   Int
  /// presentDays * dailyRate + halfPay + overtimePay (paise).
  grossPaise        Int
  /// gross - advances - deductions (paise).
  netPaise          Int
  /// FK to Payment row written in the same tx as FINALIZE; null until then.
  paymentId         String?
  /// DRAFT | FINALIZED | REVERSED
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payment    Payment?         @relation("PayrollPayment", fields: [paymentId], references: [id], onDelete: SetNull)
  snapshot   PayslipSnapshot?

  @@unique([businessId, payrollRunId, employeeId])
  @@index([businessId, employeeId])
}

/// PayslipSnapshot — immutable legal record of the payroll line items at the
/// moment of FINALIZE. Stored as JSON so future Employee/PayrollRun edits do
/// NOT mutate prior payslips.
model PayslipSnapshot {
  id         String   @id @default(cuid())
  businessId String
  payrollId  String   @unique
  /// Frozen JSON blob: { employee, period, lines, gross, deductions, net, ... }
  payload    Json
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Restrict)
}

/// PinResetToken — DH-port verbatim. Single-use; `consumedAt` flips on use.
/// `tokenHash` stored — never the raw token — so a DB leak does not enable
/// PIN reset. Background GC job purges expired rows daily.
model PinResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// AuditLogRedaction — per-business custom field redaction config. Example
/// rows: `(Party, phone)` to redact phone numbers from audit-trail diffs;
/// `(Invoice, metadata.bankAccount)` for a nested field path. The audit-write
/// service consults this table BEFORE serializing the `changes` blob.
model AuditLogRedaction {
  id          String   @id @default(cuid())
  businessId  String
  entityType  String
  fieldPath   String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator  User     @relation("AuditRedactionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([businessId, entityType, fieldPath])
}

// ───────────────────────────────────────────────────────────────────────────
// Phase 7 Slice 7.1A — Bulk Import (Parties)
// ARCH: docs/ARCHITECTURE_PHASE7_IMPORT_7_1A.md §2 (data model)
// SECURITY: docs/SECURITY_AUDIT_PHASE7_IMPORT_7_1A.md M3 — idempotencyKey binds
//   POST /commit body to the originating preview (anti-replay + anti-cross-job).
// String enums (not Prisma enum types) to keep migration additive and to
// match the orchestrator's status machine in service code.
// ───────────────────────────────────────────────────────────────────────────

model ImportJob {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  entity String // 'parties' (future: 'products' | 'invoices' | 'payments')
  format String // 'tally_xml' | 'vyapar_csv' | 'busy_xls' | 'generic_csv'
  status String // UPLOADED|PARSING|PREVIEWED|COMMITTING|COMMITTED|PARTIALLY_COMMITTED|FAILED|CANCELLED|EXPIRED

  // M3 — single-use server-issued token; bound 1:1 to a preview snapshot
  commitToken    String? @unique
  // M3 — idempotency key from client; binds /commit body to /preview output
  idempotencyKey String?

  fileName         String? // nullable so DPDP erasure can NULL it
  fileSha256       String
  fileSize         Int
  rowCount         Int     @default(0)
  errorCount       Int     @default(0)
  columnMapping    Json? // generic_csv only
  counts           Json    @default("{}") // { total, staged, errors, warnings, duplicatesExact, duplicatesNear, committed }
  // Raw audit array of created entity ids (Party for entity='parties',
  // Product for entity='product'). DB column kept as `createdPartyIds`
  // (additive Migration B1 — drop renamed in PR-followup Migration D).
  // SCOPE L216-226, Resolved Decision #15 (expand→backfill→contract).
  createdEntityIds Json    @default("[]") @map("createdPartyIds")
  clientVersion    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  committedAt DateTime?
  // 7d for STAGED jobs; 90d for terminal jobs — cron hard-deletes after
  expiresAt   DateTime

  rows      ImportJobRow[]
  // Reverse side of Party.importJob (SetNull on delete to preserve audit history)
  parties   Party[]
  // Reverse side of Document.importJob (7.1C — SetNull on delete to preserve audit history)
  documents Document[]     @relation("ImportedDocuments")
  // Reverse side of Payment.importJob (7.1D — SetNull on delete to preserve audit history)
  payments  Payment[]      @relation("ImportedPayments")

  @@index([businessId, fileSha256]) // re-upload detect
  @@index([businessId, status, updatedAt]) // active-job check + cleanup
  @@index([committedAt]) // 24h raw-PII purge cron
  @@index([expiresAt]) // hard-delete cron
  @@index([userId]) // uploader-scoped list (FE)
}

model ImportJobRow {
  id    String    @id @default(cuid())
  jobId String
  job   ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sourceIndex Int
  status      String // STAGED|ERROR|WARNING|DUPLICATE_EXACT|DUPLICATE_NEAR|COMMITTED|SKIPPED
  raw         Json? // NULLED 24h post-commit
  normalized  Json? // NULLED 24h post-commit
  // [{ field, code, severity, message }]
  issues      Json    @default("[]")
  // CSV-only dedup user decision: NONE | SKIP_EXACT | OVERWRITE | CREATE_NEW
  dedupAction String?

  matchedPartyId  String?
  matchedParty    Party?  @relation("MatchedPartyImports", fields: [matchedPartyId], references: [id], onDelete: SetNull)
  // @unique enforces "1 row → ≤1 party" at the DB level (commit-retry safe).
  // PR-followup Migration D will DROP this column once dual-write completes.
  createdPartyId  String? @unique
  createdParty    Party?  @relation("CreatedPartyImport", fields: [createdPartyId], references: [id], onDelete: SetNull)
  // Phase 7 · Slice 7.1B · Migration B1 — entity-rename EXPAND phase.
  // Backfilled from createdPartyId; dual-written by commit-parties.service.
  // Carries Product ids when entity='product'. UNIQUE is added in PR-followup
  // Migration D (after dual-write backfill completes).
  createdEntityId String?

  // Idempotency anchor for product opening-balance StockMovement rows.
  stockMovements StockMovement[] @relation("ImportRowStockMovements")

  createdAt DateTime @default(now())

  @@unique([jobId, sourceIndex])
  @@index([jobId, status])
  @@index([jobId, createdEntityId])
}

// ── Phase 7 — Bank reconciliation (#147, absorbs #89) ──────────────────────
// Additive create-table-only. Reconciliation only annotates existing Payments
// via ReconciliationMatch; it never mutates Payment/ledger rows.

model BankStatementImport {
  id            String    @id @default(cuid())
  businessId    String
  bankAccountId String
  fileName      String    @db.VarChar(255)
  rowCount      Int
  periodStart   DateTime?
  periodEnd     DateTime?
  importedBy    String
  createdAt     DateTime  @default(now())

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  importer    User                @relation("StatementImporter", fields: [importedBy], references: [id], onDelete: Restrict)
  lines       BankStatementLine[]

  @@index([businessId, createdAt])
  @@index([businessId, bankAccountId])
}

model BankStatementLine {
  id              String   @id @default(cuid())
  importId        String
  businessId      String
  bankAccountId   String
  txnDate         DateTime
  amount          Int // paise, always positive
  direction       String // CREDIT | DEBIT
  description     String?  @db.VarChar(500)
  referenceNumber String?  @db.VarChar(100)
  status          String   @default("UNMATCHED") // UNMATCHED | SUGGESTED | MATCHED | IGNORED
  createdAt       DateTime @default(now())

  import   BankStatementImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  match    ReconciliationMatch?

  @@index([businessId, bankAccountId, status])
  @@index([importId])
}

model ReconciliationMatch {
  id         String   @id @default(cuid())
  businessId String
  lineId     String   @unique // 1:1 — a line reconciles to at most one payment
  paymentId  String
  method     String // AUTO | MANUAL
  confidence Int // 0..100 integer (money-adjacent SSOT — no float)
  matchedBy  String
  createdAt  DateTime @default(now())

  line     BankStatementLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  payment  Payment           @relation("PaymentReconciliation", fields: [paymentId], references: [id], onDelete: Restrict)
  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  matcher  User              @relation("ReconciliationMatcher", fields: [matchedBy], references: [id], onDelete: Restrict)

  @@index([businessId, paymentId])
}

// Audit #5 — Google Drive backup (per-user OAuth, drive.file scope, env-gated opt-in)
model DriveBackupConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail     String
  refreshTokenEnc String // AES-256-GCM: ivB64:authTagB64:ciphertextB64 — never logged/returned
  scope           String
  connectedAt     DateTime  @default(now())
  lastBackupAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
