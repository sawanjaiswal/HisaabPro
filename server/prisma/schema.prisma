generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// === Foundation models — expanded per feature via /f ===

model User {
  id               String  @id @default(cuid())
  phone            String  @unique
  name             String?
  email            String? @unique
  passwordHash     String?
  pinHash          String?
  biometricEnabled Boolean @default(false)
  isActive         Boolean @default(true)

  // Account lockout — Feature #64
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  accountLockedUntil  DateTime?

  // Admin suspension — Feature #7
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  // Referral wallet — Feature #3 (money-SSOT: paise Int / BigInt, see EPIC_money-ssot)
  referredBy                   String?
  referralBalancePaise         Int       @default(0)
  referralBalanceInReviewPaise Int       @default(0)
  referralTotalEarnedPaise     BigInt    @default(0)
  referralFraudFlags           Int       @default(0)
  walletFrozen                 Boolean   @default(false)
  lastReferralAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-business — last active business (auto-loaded on login)
  lastActiveBusinessId String?
  lastActiveBusiness   Business? @relation("UserLastActiveBusiness", fields: [lastActiveBusinessId], references: [id], onDelete: SetNull)

  businessUsers      BusinessUser[]
  refreshTokens      RefreshToken[]
  stockMovements     StockMovement[]
  documentsCreated   Document[]         @relation("DocumentCreator")
  documentsUpdated   Document[]         @relation("DocumentUpdater")
  documentsDeleted   Document[]         @relation("DocumentDeleter")
  shareLogs          DocumentShareLog[]
  paymentsCreated    Payment[]          @relation("PaymentCreator")
  paymentsUpdated    Payment[]          @relation("PaymentUpdater")
  auditLogs          AuditLog[]
  appSettings        UserAppSettings?
  approvalsRequested ApprovalRequest[]  @relation("ApprovalRequester")
  approvalsReviewed  ApprovalRequest[]  @relation("ApprovalReviewer")

  // Referral relations
  referredByUser            User?                @relation("UserReferrals", fields: [referredBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referredUsers             User[]               @relation("UserReferrals")
  referralCode              ReferralCode?
  referralRewardsAsReferrer ReferralReward[]     @relation("ReferralRewardsReferrer")
  referralRewardsAsReferred ReferralReward[]     @relation("ReferralRewardsReferred")
  referralEventsAsReferrer  ReferralEvent[]      @relation("ReferralEventsReferrer")
  referralEventsAsReferred  ReferralEvent[]      @relation("ReferralEventsReferred")
  referralWithdrawals       ReferralWithdrawal[]
  couponRedemptions         CouponRedemption[]
  webauthnCredentials       WebAuthnCredential[]

  // Phase 3 — Accounting
  expensesCreated         Expense[]           @relation("ExpenseCreator")
  otherIncomesCreated     OtherIncome[]       @relation("OtherIncomeCreator")
  stockVerifications      StockVerification[]
  expenseTemplatesCreated ExpenseTemplate[]   @relation("ExpenseTemplateCreator")
  expenseBudgetsCreated   ExpenseBudget[]     @relation("ExpenseBudgetCreator")

  // Phase 4 — Multi-Godown transfers
  godownTransfers GodownTransfer[]

  // Notifications Engine
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushTokens              PushToken[]

  // Phase 4 — POS Billing
  posSalesAsCashier  PosSale[] @relation("PosCashier")
  posSalesAsVoider   PosSale[] @relation("PosVoider")
  posSalesAsRestorer PosSale[] @relation("PosRestorer")

  // Phase 4 — BOM / Manufacturing
  bomsCreated           Bom[]           @relation("BomCreator")
  productionRunsCreated ProductionRun[] @relation("ProductionRunCreator")

  // Epic C — Public shared links issued by this user
  issuedSharedLinks SharedLink[]

  // Epic C PR5 — Party invite: one User may claim at most one Party globally (MVP)
  linkedParties Party[]

  // Phase 5 Epic D — Commission #128 — reverse for staff commission ledger
  staffCommissionLedger CommissionLedger[] @relation("StaffCommissionLedger")

  // Phase 6 — Staff & HR back-relations
  employeesAsLogin       Employee[]          @relation("EmployeeUser")
  employeesCreated       Employee[]          @relation("EmployeeCreator")
  attendancesCreated     Attendance[]        @relation("AttendanceCreator")
  payrollRunsFinalized   PayrollRun[]        @relation("PayrollRunFinalizer")
  payrollRunsCreated     PayrollRun[]        @relation("PayrollRunCreator")
  pinResetTokens         PinResetToken[]
  auditRedactionsCreated AuditLogRedaction[] @relation("AuditRedactionCreator")
  suspendedMemberships   BusinessUser[]      @relation("BusinessUserSuspender")

  // Phase 7 — Import
  importJobs        ImportJob[]
  importedParties   Party[]     @relation("ImportedParties")
  importedDocuments Document[]  @relation("ImportedDocuments")
  importedPayments  Payment[]   @relation("PaymentImporter")

  // Phase 7 — Bank reconciliation (#147)
  statementImports      BankStatementImport[] @relation("StatementImporter")
  reconciliationMatches ReconciliationMatch[] @relation("ReconciliationMatcher")

  // Audit #5 — Google Drive backup connection (per-user OAuth)
  driveBackupConnection DriveBackupConnection?

  @@index([phone])
  @@index([referredBy])
  @@index([referralFraudFlags])
  @@index([lastReferralAt])
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  logoUrl            String?
  businessType       String   @default("general")
  currencyCode       String   @default("INR")
  financialYearStart Int      @default(4) // April
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // MSME compliance
  udyamNumber String? // UDYAM-XX-XX-XXXXXXX format

  // GST — Phase 2
  gstin             String?
  stateCode         String? // 2-digit, extracted from GSTIN pos 0-1
  compositionScheme Boolean @default(false)
  eInvoiceEnabled   Boolean @default(false)
  eWayBillEnabled   Boolean @default(false)
  turnoverSlab      String? // Tracks e-invoice threshold eligibility

  // GST Phase 2 — new fields (migration: 20260505190000_gst_phase_2_fields)
  gstEnabled         Boolean @default(false)
  taxPricingMode     String  @default("EXCLUSIVE") @db.VarChar(20) // EXCLUSIVE | INCLUSIVE
  gstDeclarationText String? @db.Text // null = use in-code default per SCOPE §8.4

  // Phase 2.2 — Batch tracking + Expiry policy (migration: 20260507160000_inventory_batches_columns)
  expiryAlertDays    Int?   @default(30) // 0 = no advance alerts; null = inherit default 30
  expiredBatchPolicy String @default("WARN_ONLY") // WARN_ONLY | HARD_BLOCK — independent of stockValidationMode

  // #132 — Price Lists: SSOT for business default tier
  defaultPriceListId String?

  // Epic C PR2 — #129 UPI QR on invoice (migration: epic_c_business_upi_vpa)
  upiVpa String? @db.VarChar(320) // VPA format: name@bank

  businessUsers             BusinessUser[]
  parties                   Party[]
  partyGroups               PartyGroup[]
  customFields              CustomFieldDefinition[]
  documentCustomFieldValues DocumentCustomFieldValue[]
  categories                Category[]
  units                     Unit[]
  products                  Product[]
  unitConversions           UnitConversion[]
  stockMovements            StockMovement[]
  inventorySetting          InventorySetting?
  documents                 Document[]
  documentNumberSeries      DocumentNumberSeries[]
  documentSettings          DocumentSettings?
  digitalSignature          DigitalSignature?
  termsTemplates            TermsAndConditionsTemplate[]
  payments                  Payment[]
  paymentReminders          PaymentReminder[]
  reminderConfig            ReminderConfig?
  roles                     Role[]
  staffInvites              StaffInvite[]
  transactionLock           TransactionLockConfig?
  approvals                 ApprovalRequest[]
  auditLogs                 AuditLog[]
  taxCategories             TaxCategory[]
  gstReturns                GstReturn[]
  gstReconciliations        GstReconciliation[]
  recurringInvoices         RecurringInvoice[]
  recurringRuns             RecurringInvoiceRun[]
  exchangeRates             ExchangeRate[]

  // Phase 3 — Accounting
  ledgerAccounts    LedgerAccount[]
  journalEntries    JournalEntry[]
  bankAccounts      BankAccount[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  otherIncomes      OtherIncome[]
  cheques           Cheque[]
  loanAccounts      LoanAccount[]
  fyClosures        FinancialYearClosure[]

  stockAlerts        StockAlert[]
  stockVerifications StockVerification[]

  // Phase 4 — Batch Tracking + Multi-Godown + Serial Numbers
  batches         Batch[]
  godowns         Godown[]
  godownStocks    GodownStock[]
  godownTransfers GodownTransfer[]
  serialNumbers   SerialNumber[]

  // Business-Verticals Phase 3 — Services jobs
  jobs Job[]

  // Business-Verticals Phase 4 — Bakery/tailor vertical
  customOrders CustomOrder[]

  // Payments & Collections Hub
  paymentLinks       PaymentLink[]
  promisesToPay      PromiseToPay[]
  reminderLogs       ReminderLog[]
  collectionCadences CollectionCadence[]

  usersLastActive User[]        @relation("UserLastActiveBusiness")
  subscription    Subscription?

  // Cash Register
  cashEntries CashEntry[]

  // Expenses Upgrade — PR1
  expenseTemplates ExpenseTemplate[]
  expenseBudgets   ExpenseBudget[]

  // Notifications Engine
  notifications           Notification[]
  notificationJobs        NotificationJob[]
  notificationPreferences NotificationPreference[]
  notificationCostTallies NotificationCostTally[]
  pushTokens              PushToken[]

  // Phase 4 — POS Billing
  posSales           PosSale[]
  posReceiptCounters PosReceiptCounter[]
  posSettings        PosSetting?

  // Phase 4 — BOM / Manufacturing
  boms           Bom[]
  productionRuns ProductionRun[]

  // Phase 5 — Marketing Communications
  marketingTemplates MarketingTemplate[]
  marketingCampaigns MarketingCampaign[]
  reminderRules      ReminderRule[]

  // #132 — Price Lists
  priceLists       PriceList[] @relation("BusinessPriceLists")
  defaultPriceList PriceList?  @relation("BusinessDefaultPriceList", fields: [defaultPriceListId], references: [id], onDelete: SetNull)

  // Epic C — Public shared links
  sharedLinks SharedLink[]

  // subscription-port — new relations
  subscriptionEvents SubscriptionEvent[]
  businessAddons     BusinessAddon[]
  upiMandates        UpiMandate[]

  // Epic C PR4 — Online Storefront (#121, migration: epic_c_storefront_fields)
  storefrontSlug     String? @unique // null = not configured; stored lowercased at write time
  storefrontIsPublic Boolean @default(false)
  storefrontTagline  String? // max 80 chars (enforced by Zod)
  storefrontTheme    String  @default("LIGHT") // "LIGHT" | "DARK"
  storefrontWhatsapp String? // E.164 digits without +; falls back to Business.phone

  storefrontProducts StorefrontProduct[]

  // Phase 5 Epic D — Loyalty #125 + Commission #128 (migration: phase5_epic_d_crm_loyalty_commission)
  loyaltyProgram   LoyaltyProgram?
  loyaltyLedger    LoyaltyLedger[]
  commissionRules  CommissionRule[]
  commissionLedger CommissionLedger[]

  // Phase 6 — firm-level suspend (architecture §3.5; requireActiveBusiness emits FIRM_SUSPENDED 403)
  suspendedAt DateTime?

  // Phase 6 — Staff & HR back-relations
  employees        Employee[]
  attendances      Attendance[]
  employeeAdvances EmployeeAdvance[]
  payrollRuns      PayrollRun[]
  payrolls         Payroll[]
  payslipSnapshots PayslipSnapshot[]
  auditRedactions  AuditLogRedaction[]

  // Phase 7 — Import
  importJobs ImportJob[]

  // Phase 7 — Bank reconciliation (#147)
  statementImports      BankStatementImport[]
  statementLines        BankStatementLine[]
  reconciliationMatches ReconciliationMatch[]

  @@index([name])
}

model BusinessUser {
  id           String    @id @default(cuid())
  userId       String
  businessId   String
  role         String    @default("owner")
  roleId       String?
  isActive     Boolean   @default(true)
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  lastActiveAt DateTime?
  joinedAt     DateTime  @default(now())

  // Phase 6 — member-suspend audit trail (architecture §3.5).
  // `status='SUSPENDED'` already existed; `suspendedAt` + `suspendedById`
  // add WHO + WHEN so requireActiveBusiness can return MEMBER_SUSPENDED with
  // the timestamp + audit-link metadata. Nullable forever.
  suspendedAt   DateTime?
  suspendedById String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  roleRef     Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  suspendedBy User?    @relation("BusinessUserSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([businessId, suspendedAt])
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  family        String?
  replacedBy    String?
  revokedAt     DateTime?
  revokedReason String?
  deviceInfo    String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@index([userId, revokedAt, expiresAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  context   String? // JSON: { purpose: 'registration'|'password_reset', name?, passwordHash? }

  @@index([phone, verified])
  @@index([expiresAt])
}

model IdempotencyLog {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Feedback {
  id         String   @id @default(cuid())
  userId     String?
  type       String // bug, feature, general
  message    String
  rating     Int?
  screenshot String? // base64 or URL
  metadata   Json? // device info, page, etc.
  status     String   @default("open") // open, reviewed, resolved
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
}

// === Party Management ===

model Party {
  id                 String    @id @default(cuid())
  businessId         String
  name               String
  phone              String?
  email              String?
  companyName        String?
  type               String    @default("CUSTOMER") // CUSTOMER, SUPPLIER, BOTH, STAFF
  groupId            String?
  tags               String[]  @default([])
  gstin              String?
  stateCode          String? // 2-digit, extracted from GSTIN pos 0-1
  gstinVerified      Boolean   @default(false)
  gstinVerifiedAt    DateTime?
  compositionScheme  Boolean   @default(false)
  pan                String?
  creditLimit        Int       @default(0) // in paise, 0 = no limit
  creditLimitMode    String    @default("WARN") // WARN, BLOCK
  outstandingBalance Int       @default(0) // in paise, positive = receivable, negative = payable
  totalBusiness      Int       @default(0) // in paise, lifetime total
  lastTransactionAt  DateTime?
  notes              String?
  isActive           Boolean   @default(true)
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(0) // #150 optimistic-lock token

  // Phase 4 — POS walk-in sentinel
  isWalkIn Boolean @default(false)

  // Phase 5 — Marketing Communications
  birthday          DateTime?
  marketingOptOut   Boolean   @default(false)
  marketingOptOutAt DateTime?

  // Phase 5 Epic D — CRM #127 (migration: phase5_epic_d_crm_loyalty_commission)
  // SERVER-ONLY fields — write only from touchLastContacted hooks / dedicated routes
  // (see ARCHITECTURE_EPIC_D §3.6 + schemas/party.schemas.ts allow-list discipline)
  lastContactedAt DateTime?
  followUpAt      DateTime?

  // #132 — Price Lists
  priceListId String?

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group             PartyGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addresses         PartyAddress[]
  customFieldValues PartyCustomFieldValue[]
  openingBalance    OpeningBalance?
  pricing           PartyPricing[]
  documents         Document[]
  payments          Payment[]
  paymentReminders  PaymentReminder[]
  jobs              Job[]
  customOrders      CustomOrder[]
  paymentLinks      PaymentLink[]
  promisesToPay     PromiseToPay[]
  reminderLogs      ReminderLog[]
  posSales          PosSale[]

  // Phase 5 — Marketing relations
  marketingCampaignRecipients MarketingCampaignRecipient[]
  reminderInstances           ReminderInstance[]

  // #132 — Price Lists
  priceList PriceList? @relation("PartyPriceList", fields: [priceListId], references: [id], onDelete: SetNull)

  // Epic C PR5 — invite-claim: one User per Party (MVP); DB-level uniqueness prevents hijack
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Phase 5 Epic D — Loyalty #125 reverse
  loyaltyLedger LoyaltyLedger[]

  // Phase 6 — Staff & HR: paired STAFF Party owns one Employee row (architecture §8.5).
  employee Employee? @relation("EmployeeParty")

  // Phase 7 — Import provenance (additive, nullable — legacy parties have none)
  importJobId    String?
  importedBy     String?
  importJob      ImportJob?     @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  importedByUser User?          @relation("ImportedParties", fields: [importedBy], references: [id], onDelete: SetNull)
  matchedRows    ImportJobRow[] @relation("MatchedPartyImports")
  sourceRow      ImportJobRow?  @relation("CreatedPartyImport")

  @@unique([businessId, phone])
  @@index([businessId, type, isActive])
  @@index([businessId, name])
  @@index([businessId, outstandingBalance])
  @@index([businessId, isDeleted])
  @@index([businessId, isWalkIn])
  @@index([businessId, marketingOptOut])
  @@index([groupId])
  @@index([businessId, priceListId])
  // Phase 5 Epic D — CRM #127 indexes (architecture §2.5)
  @@index([businessId, followUpAt])
  @@index([businessId, lastContactedAt])
  // v3 / M3 covering composite — backs /api/parties/follow-ups (filter by businessId,
  // range on lastContactedAt, exclude inactive) — keeps p95 < 30ms at 50k parties.
  @@index([businessId, lastContactedAt, isActive], map: "idx_party_business_lastcontact_active")
  // Phase 7 — Import
  @@index([importJobId])
  @@index([businessId, importJobId])
}

model PartyAddress {
  id        String    @id @default(cuid())
  partyId   String
  label     String    @default("Default")
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  type      String    @default("BILLING") // BILLING, SHIPPING
  isDefault Boolean   @default(false)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, type])
  @@index([partyId, isDeleted])
}

model PartyGroup {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  color       String    @default("#6B7280")
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parties  Party[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model CustomFieldDefinition {
  id            String    @id @default(cuid())
  businessId    String
  name          String
  fieldType     String // TEXT, NUMBER, DATE, DROPDOWN
  options       String[]  @default([]) // for DROPDOWN type
  required      Boolean   @default(false)
  showOnInvoice Boolean   @default(false)
  entityType    String    @default("PARTY") // PARTY, PRODUCT, DOCUMENT
  // #134 — when entityType = DOCUMENT, restrict field to specific doc types.
  // Empty array = applies to all doc types. Values: INVOICE, ESTIMATE, SALE_ORDER, DELIVERY_CHALLAN
  documentTypes String[]  @default([])
  sortOrder     Int       @default(0)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business       Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  values         PartyCustomFieldValue[]
  productValues  ProductCustomFieldValue[]
  documentValues DocumentCustomFieldValue[]

  @@unique([businessId, name, entityType])
  @@index([businessId, entityType])
  @@index([businessId, isDeleted])
}

// #134 — per-document custom field value (JSONB).
// One row per (documentId, fieldDefId). On document delete: cascade.
// On field-def delete: Restrict (we soft-delete defs, so this surfaces orphans).
model DocumentCustomFieldValue {
  id         String   @id @default(cuid())
  documentId String
  fieldDefId String
  businessId String
  valueJson  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldDef CustomFieldDefinition @relation(fields: [fieldDefId], references: [id], onDelete: Restrict)
  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([documentId, fieldDefId])
  @@index([documentId])
  @@index([businessId, fieldDefId])
  @@index([fieldDefId])
}

model PartyCustomFieldValue {
  id        String   @id @default(cuid())
  partyId   String
  fieldId   String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party                 @relation(fields: [partyId], references: [id], onDelete: Cascade)
  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([partyId, fieldId])
  @@index([fieldId])
}

model OpeningBalance {
  id        String    @id @default(cuid())
  partyId   String    @unique
  amount    Int // in paise
  type      String // RECEIVABLE, PAYABLE
  asOfDate  DateTime
  notes     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model PartyPricing {
  id        String    @id @default(cuid())
  partyId   String
  productId String
  price     Int // in paise
  minQty    Int       @default(1)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([partyId, productId])
  @@index([productId])
  @@index([partyId, isDeleted])
}

// === Price Lists (#132) ===

enum PriceListMode {
  ABSOLUTE
  PERCENT_OFF
  FIXED_OFF
}

model PriceList {
  id         String    @id @default(cuid())
  businessId String
  name       String // max 60 chars (validated in zod)
  isDefault  Boolean   @default(false) // denorm mirror of Business.defaultPriceListId; resolver never trusts this — reads Business.defaultPriceListId
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business             Business         @relation("BusinessPriceLists", fields: [businessId], references: [id], onDelete: Restrict)
  entries              PriceListEntry[]
  parties              Party[]          @relation("PartyPriceList")
  defaultForBusinesses Business[]       @relation("BusinessDefaultPriceList")
  documentOverrides    Document[]       @relation("DocumentPriceListOverride")

  @@unique([businessId, name])
  @@index([businessId, isDeleted])
}

model PriceListEntry {
  id            String        @id @default(cuid())
  priceListId   String
  productId     String
  mode          PriceListMode
  // exactly one of the three value columns is non-null per row, enforced by zod + DB CHECK in application layer:
  valuePaise    Int? // for ABSOLUTE: final price in paise
  percentBps    Int? // for PERCENT_OFF: 0..10000 (10000 = 100%)
  fixedOffPaise Int? // for FIXED_OFF: discount amount in paise
  minQty        Int           @default(1)
  maxQty        Int? // null = "and above" (open-ended upper bound)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([priceListId, productId, minQty])
  @@index([priceListId, productId, isDeleted])
  @@index([productId])
}

// === Inventory & Products ===

model Category {
  id         String    @id @default(cuid())
  businessId String
  name       String
  type       String    @default("CUSTOM") // PREDEFINED, CUSTOM
  color      String    @default("#6B7280")
  sortOrder  Int       @default(0)
  isHidden   Boolean   @default(false) // hide predefined without deleting
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model Unit {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  symbol         String
  type           String    @default("CUSTOM") // PREDEFINED, CUSTOM
  category       String    @default("OTHER") // WEIGHT, VOLUME, COUNT, LENGTH, AREA, SERVICE, PACKAGING, OTHER
  decimalAllowed Boolean   @default(true) // false for pcs/box, true for kg/ltr
  baseUnitId     String? // Self-ref: Box of 12 → pcs
  baseUnitFactor Float? // 1 box12 = 12 pcs
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  baseUnit        Unit?            @relation("UnitBase", fields: [baseUnitId], references: [id], onDelete: SetNull)
  derivedUnits    Unit[]           @relation("UnitBase")
  products        Product[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
  bomComponents   BomComponent[]

  @@unique([businessId, name])
  @@unique([businessId, symbol])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model UnitConversion {
  id         String    @id @default(cuid())
  businessId String
  fromUnitId String
  toUnitId   String
  factor     Float // 1 fromUnit = factor toUnits
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromUnit Unit     @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit   Unit     @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Restrict)

  @@unique([businessId, fromUnitId, toUnitId])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model Product {
  id                   String    @id @default(cuid())
  businessId           String
  name                 String
  sku                  String?
  categoryId           String?
  unitId               String
  salePrice            Int       @default(0) // in paise
  purchasePrice        Int? // in paise
  currentStock         Float     @default(0) // supports decimals for kg/ltr
  minStockLevel        Float     @default(0)
  stockValidation      String    @default("GLOBAL") // GLOBAL, WARN_ONLY, HARD_BLOCK
  hsnCode              String?
  sacCode              String?
  taxCategoryId        String? // FK → TaxCategory (default GST rate for this product)
  description          String?
  barcode              String? // optional barcode value (EAN13, CODE128, etc.)
  barcodeFormat        String? // CODE128, EAN13, EAN8, UPC, QR, CODE39
  status               String    @default("ACTIVE") // ACTIVE, INACTIVE
  // Feature #108 — Item Images
  imageUrl             String? // primary image URL
  images               String[]  @default([]) // up to 5 image URLs
  // Feature #109 — MOQ (min order quantity)
  moq                  Int?
  // Inventory Phase 2 — reorder threshold (null = not set; 0 = explicit zero)
  reorderQty           Float?
  // Inventory Phase 2 — weighted-average purchase cost (paise). Updated on every SAVED purchase.
  weightedAvgCostPaise BigInt    @default(0)
  // Feature #103 — Label Printing
  labelTemplate        String?   @default("standard") // "standard" | "compact" | "barcode-only"
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  version              Int       @default(0) // #150 optimistic-lock token

  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit              Unit                      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxCategory       TaxCategory?              @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  stockMovements    StockMovement[]
  customFieldValues ProductCustomFieldValue[]
  partyPricing      PartyPricing[]
  documentLineItems DocumentLineItem[]
  stockAlerts       StockAlert[]
  verificationItems StockVerificationItem[]

  // Phase 4 — Batch Tracking + Multi-Godown + Serial Numbers
  batches         Batch[]
  godownStocks    GodownStock[]
  godownTransfers GodownTransfer[]
  serialNumbers   SerialNumber[]

  // Business-Verticals Phase 3 — optional link from a JobItem to a catalog product
  jobItems JobItem[] @relation("JobItemProduct")

  // Business-Verticals Phase 4 — optional link from a CustomOrderItem to a catalog product
  customOrderItems CustomOrderItem[] @relation("CustomOrderItemProduct")

  // Phase 4 — POS Billing
  posSaleItems PosSaleItem[]

  // Phase 4 — BOM / Manufacturing
  bomsAsFinishedGood       Bom[]                    @relation("BomFinishedGood")
  bomComponents            BomComponent[]           @relation("BomComponentProduct")
  productionRunsAsFinished ProductionRun[]          @relation("ProductionRunFinished")
  productionRunComponents  ProductionRunComponent[] @relation("ProductionRunComponents")

  // #132 — Price Lists (Restrict so a product in use cannot be hard-deleted — soft delete only)
  priceListEntries PriceListEntry[]

  // Epic C PR4 — Online Storefront back-relation
  storefrontProducts StorefrontProduct[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@index([businessId, name])
  @@index([businessId, currentStock, minStockLevel])
  @@index([businessId, isDeleted])
}

// Epic C PR4 — Online Storefront join table (#121, migration: epic_c_storefront_fields)
model StorefrontProduct {
  id           String   @id @default(cuid())
  businessId   String
  productId    String
  priceVisible Boolean  @default(true)
  sortOrder    Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([businessId, productId])
  @@index([businessId, sortOrder])
}

model StockMovement {
  id              String   @id @default(cuid())
  businessId      String
  productId       String
  type            String // OPENING, SALE, PURCHASE, ADJUSTMENT_IN, ADJUSTMENT_OUT, RETURN_IN, RETURN_OUT, REVERSAL
  quantity        Float // positive = in, negative = out
  balanceAfter    Float
  reason          String? // DAMAGE, THEFT, AUDIT, GIFT, RETURN, OTHER
  customReason    String?
  notes           String?
  referenceType   String? // SALE_INVOICE, PURCHASE_INVOICE, CREDIT_NOTE, DEBIT_NOTE, ADJUSTMENT
  referenceId     String?
  referenceNumber String?
  movementDate    DateTime @default(now())
  createdBy       String
  createdAt       DateTime @default(now())

  // Phase 4 — Batch Tracking + Multi-Godown (nullable, backward-compatible)
  batchId  String?
  godownId String?

  // Phase 7 · Slice 7.1B · Migration B1+B2 — opening-balance idempotency.
  // Partial UNIQUE on (importJobRowId) WHERE importJobRowId IS NOT NULL
  // (Migration B2). On commit-retry, ON CONFLICT DO NOTHING blocks dupes.
  importJobRowId String?
  importJobRow   ImportJobRow? @relation("ImportRowStockMovements", fields: [importJobRowId], references: [id], onDelete: SetNull)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  godown   Godown?  @relation(fields: [godownId], references: [id], onDelete: SetNull)

  // Immutable — no updatedAt
  @@index([productId, createdAt])
  @@index([businessId, movementDate])
  @@index([referenceType, referenceId])
  @@index([batchId])
  @@index([godownId])
}

model ProductCustomFieldValue {
  id        String   @id @default(cuid())
  productId String
  fieldId   String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldId])
  @@index([fieldId])
}

model InventorySetting {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  stockValidationMode    String   @default("WARN_ONLY") // WARN_ONLY, HARD_BLOCK
  skuPrefix              String   @default("PRD")
  skuAutoGenerate        Boolean  @default(true)
  skuNextCounter         Int      @default(1)
  lowStockAlertEnabled   Boolean  @default(true)
  lowStockAlertFrequency String   @default("DAILY") // ONCE, DAILY, EVERY_TIME
  decimalPrecisionQty    Int      @default(2)
  defaultCategoryId      String?
  defaultUnitId          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// === Invoicing & Documents ===

model Document {
  id         String @id @default(cuid())
  businessId String
  type       String // SALE_INVOICE, PURCHASE_INVOICE, ESTIMATE, PROFORMA, SALE_ORDER, PURCHASE_ORDER, DELIVERY_CHALLAN
  status     String @default("DRAFT") // DRAFT, SAVED, SHARED, CONVERTED, DELETED

  // Numbering
  documentNumber String? // Assigned on SAVE, null for DRAFT
  sequenceNumber Int?
  financialYear  String? // "2526" (April 2025 - March 2026)

  // Party
  partyId           String
  shippingAddressId String?

  // Dates
  documentDate DateTime
  dueDate      DateTime?
  paymentTerms String? // COD, NET_7, NET_15, NET_30, NET_60, NET_90, CUSTOM

  // Totals (PAISE — integer)
  subtotal               Int @default(0)
  totalDiscount          Int @default(0)
  totalAdditionalCharges Int @default(0)
  roundOff               Int @default(0)
  grandTotal             Int @default(0)

  // GST — Phase 2
  placeOfSupply     String? // 2-digit state code
  supplyType        String  @default("B2B") // B2B, B2C_LARGE, B2C_SMALL, EXPORT, SEZ
  isReverseCharge   Boolean @default(false)
  isComposite       Boolean @default(false)
  totalTaxableValue Int     @default(0) // paise — sum of line taxableValues
  totalCgst         Int     @default(0) // paise
  totalSgst         Int     @default(0) // paise
  totalIgst         Int     @default(0) // paise
  totalCess         Int     @default(0) // paise
  taxPricingMode    String  @default("EXCLUSIVE") @db.VarChar(20) // EXCLUSIVE | INCLUSIVE — GST Phase 2

  // TDS/TCS — Phase 2B (B2B invoice deductions)
  tdsRate   Int @default(0) // basis points
  tdsAmount Int @default(0) // paise
  tcsRate   Int @default(0) // basis points
  tcsAmount Int @default(0) // paise

  // Multi-currency — Phase 2E
  currencyCode         String @default("INR") @db.VarChar(3)
  exchangeRate         Int    @default(100) // rate * 100 (1 USD = 8400 means Rs 84.00)
  foreignCurrencyTotal Int    @default(0) // amount in foreign currency minor units

  // Profit
  totalCost     Int   @default(0)
  totalProfit   Int   @default(0)
  profitPercent Float @default(0)

  // Content
  notes              String? @db.Text
  termsAndConditions String? @db.Text
  includeSignature   Boolean @default(false)

  // Transport (Delivery Challan)
  vehicleNumber  String?
  driverName     String?
  transportNotes String?

  // Price-list per-invoice override (Epic B PR2) — nullable FK; null = use Party or Business default
  priceListId String?
  priceList   PriceList? @relation("DocumentPriceListOverride", fields: [priceListId], references: [id], onDelete: SetNull)

  // Conversion chain
  sourceDocumentId String?   @unique
  sourceDocument   Document? @relation("DocumentConversion", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  convertedTo      Document? @relation("DocumentConversion")

  // Payment tracking (denormalized from payments)
  paidAmount Int @default(0)
  balanceDue Int @default(0)

  // Recycle bin / Soft delete
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  permanentDeleteAt DateTime?

  // Audit
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0) // #150 optimistic-lock token

  // Offline sync
  clientId String? @unique

  // Phase 7 — Import provenance (7.1C additive, nullable — legacy docs have none)
  importJobId String?
  importedBy  String?

  // Relations
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party          Party      @relation(fields: [partyId], references: [id], onDelete: Restrict)
  creator        User       @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater        User?      @relation("DocumentUpdater", fields: [updatedBy], references: [id])
  deleter        User?      @relation("DocumentDeleter", fields: [deletedBy], references: [id])
  importJob      ImportJob? @relation("ImportedDocuments", fields: [importJobId], references: [id], onDelete: SetNull)
  importedByUser User?      @relation("ImportedDocuments", fields: [importedBy], references: [id], onDelete: SetNull)
  // E-Compliance — Phase 2
  eInvoice       EInvoice?
  eWayBill       EWayBill?

  // Recurring — Phase 2
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  isRecurring        Boolean           @default(false) // true when used as a recurring template

  // Recurring run back-relation (populated when this doc was auto-generated)
  recurringRun RecurringInvoiceRun? @relation("RecurringRunDocument")

  // Credit/Debit Note link
  originalDocumentId String?
  creditDebitReason  String?    @db.VarChar(500)
  originalDocument   Document?  @relation("CreditDebitLink", fields: [originalDocumentId], references: [id], onDelete: SetNull)
  creditDebitNotes   Document[] @relation("CreditDebitLink")

  lineItems          DocumentLineItem[]
  additionalCharges  DocumentAdditionalCharge[]
  customFieldValues  DocumentCustomFieldValue[]
  shareLogs          DocumentShareLog[]
  paymentAllocations PaymentAllocation[]
  paymentReminders   PaymentReminder[]
  serialNumbers      SerialNumber[]

  // Payments & Collections Hub
  paymentLinks  PaymentLink[]  @relation("PaymentLinkInvoice")
  promisesToPay PromiseToPay[] @relation("PtpInvoice")
  reminderLogs  ReminderLog[]  @relation("ReminderLogInvoice")

  // Business-Verticals Phase 3 — set when this Document was produced by converting a Job
  jobOrigin Job? @relation("JobInvoice")

  // Business-Verticals Phase 4 — set when this Document was produced by converting a CustomOrder
  customOrderOrigin CustomOrder? @relation("CustomOrderInvoice")

  // Phase 4 — POS Billing
  posSale PosSale?

  // Phase 5 Epic D — Loyalty #125 + Commission #128 reverse
  loyaltyLedger    LoyaltyLedger[]
  commissionLedger CommissionLedger[]

  @@unique([businessId, type, documentNumber])
  @@index([businessId, type, status])
  @@index([businessId, partyId])
  @@index([businessId, partyId, documentDate]) // ledger window query
  @@index([businessId, documentDate])
  @@index([businessId, isDeleted])
  @@index([permanentDeleteAt])
  @@index([clientId])
  @@index([recurringInvoiceId])
  @@index([originalDocumentId])
  @@index([businessId, type, status, documentDate])
  @@index([businessId, dueDate])
  @@index([businessId, balanceDue])
  @@index([priceListId])
  // Phase 7 — Import
  @@index([businessId, importJobId])
}

model DocumentLineItem {
  id         String @id @default(cuid())
  documentId String
  productId  String
  sortOrder  Int    @default(0)

  quantity       Float // supports decimals (kg/ltr)
  rate           Int // PAISE
  discountType   String @default("AMOUNT") // AMOUNT, PERCENTAGE
  discountValue  Int    @default(0) // paise for AMOUNT, basis points (x100) for PERCENTAGE
  discountAmount Int    @default(0) // calculated paise
  lineTotal      Int    @default(0) // (qty * rate) - discountAmount

  // GST — Phase 2 (all amounts in PAISE, rates in BASIS POINTS)
  taxCategoryId String?
  hsnCode       String?
  sacCode       String?
  taxableValue  Int     @default(0) // paise — equals lineTotal (taxable amount after discount)
  cgstRate      Int     @default(0) // basis points (e.g. 900 = 9%)
  cgstAmount    Int     @default(0) // paise
  sgstRate      Int     @default(0) // basis points
  sgstAmount    Int     @default(0) // paise
  igstRate      Int     @default(0) // basis points (e.g. 1800 = 18%)
  igstAmount    Int     @default(0) // paise
  cessRate      Int     @default(0) // basis points
  cessAmount    Int     @default(0) // paise

  // Snapshot at time of invoice
  purchasePrice Int   @default(0)
  profit        Int   @default(0)
  profitPercent Float @default(0)

  // Stock snapshot
  stockBefore Float @default(0)
  stockAfter  Float @default(0)

  // #133 BOGO — when true, line contributes 0 to totals; stock still decrements
  isFreeItem Boolean @default(false)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([productId])
}

model DocumentAdditionalCharge {
  id         String @id @default(cuid())
  documentId String
  name       String
  type       String @default("FIXED") // FIXED, PERCENTAGE
  value      Int    @default(0) // paise for FIXED, basis points for PERCENTAGE
  amount     Int    @default(0) // calculated paise
  sortOrder  Int    @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentShareLog {
  id             String   @id @default(cuid())
  documentId     String
  channel        String // WHATSAPP, EMAIL, PRINT
  format         String // PDF, JPG, PNG
  recipientPhone String?
  recipientEmail String?
  fileUrl        String?
  fileSize       Int?
  message        String?  @db.Text
  sentBy         String
  sentAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [sentBy], references: [id], onDelete: Restrict)

  @@index([documentId])
}

model DocumentNumberSeries {
  id            String @id @default(cuid())
  businessId    String
  documentType  String // SALE_INVOICE, PURCHASE_INVOICE, etc.
  financialYear String // "2526"

  prefix          String    @default("INV")
  suffix          String    @default("")
  separator       String    @default("-")
  paddingDigits   Int       @default(3)
  currentSequence Int       @default(0)
  startingNumber  Int       @default(1)
  resetOnNewYear  Boolean   @default(true)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, documentType, financialYear])
  @@index([businessId, isDeleted])
}

model DigitalSignature {
  id         String   @id @default(cuid())
  businessId String   @unique
  imageUrl   String
  autoApply  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model TermsAndConditionsTemplate {
  id         String    @id @default(cuid())
  businessId String
  name       String
  content    String    @db.Text
  isDefault  Boolean   @default(false)
  appliesTo  String[]  @default([]) // Document types this applies to
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model DocumentSettings {
  id                      String   @id @default(cuid())
  businessId              String   @unique
  defaultPaymentTerms     String   @default("COD")
  roundOffTo              String   @default("NEAREST_1") // NONE, NEAREST_1, NEAREST_050, NEAREST_010
  showProfitDuringBilling Boolean  @default(true)
  allowFutureDates        Boolean  @default(false)
  transactionLockDays     Int      @default(0)
  recycleBinRetentionDays Int      @default(30)
  autoShareOnSave         Boolean  @default(false)
  autoShareChannel        String   @default("WHATSAPP")
  autoShareFormat         String   @default("PDF")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // GST Phase 2 — new field (migration: 20260505190000_gst_phase_2_fields)
  taxPricingMode String @default("EXCLUSIVE") @db.VarChar(20) // EXCLUSIVE | INCLUSIVE

  // Catalog Enrichment Phase 4 — migration: 20260508120000_catalog_enrichment_settings_and_indexes
  enforceMoq         Boolean @default(true) // true = hard block on BELOW_MOQ; false = warning only
  showLineItemImages Boolean @default(false) // show product thumbnails on invoice line items

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// === Payment Tracking ===

model Payment {
  id              String    @id @default(cuid())
  offlineId       String?   @unique
  businessId      String
  type            String // PAYMENT_IN, PAYMENT_OUT, PAYROLL_OUT, PAYROLL_IN (Phase 6 widening — see shared/enums.ts PAYMENT_TYPES)
  partyId         String
  amount          Int // paise
  date            DateTime
  mode            String // CASH, UPI, BANK_TRANSFER, CHEQUE, NEFT_RTGS_IMPS, CREDIT_CARD, OTHER
  referenceNumber String?   @db.VarChar(100)
  notes           String?   @db.VarChar(500)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  version         Int       @default(0) // #150 optimistic-lock token

  // Phase 6 — payroll reversal pointer (A04.1 closure v2.3).
  // When a finalized PayrollRun is reversed, the service writes an inverse-
  // direction-same-amount PAYROLL_IN row pointing back at the original
  // PAYROLL_OUT via `reversesPaymentId`. `@unique` enforces "no reversal of a
  // reversal at the DB level — a second attempt to write the same
  // reversesPaymentId triggers Prisma P2002, which the service translates to
  // AppError(PAYROLL_ALREADY_REVERSED, 409). Nullable forever; existing rows
  // (and all non-reversal payments) leave it null. See architecture §8.3.
  reversesPaymentId String?   @unique
  reversesPayment   Payment?  @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: SetNull)
  reversedBy        Payment[] @relation("PaymentReversal")

  // Phase 7 #149 Slice 7.1D — Payments Import provenance.
  // Nullable forever; existing rows (and all hand-entered payments) leave both null.
  // SetNull on ImportJob delete preserves Payment ledger across DPDP cleanup.
  importJobId String?
  importedBy  String?
  importJob   ImportJob? @relation("ImportedPayments", fields: [importJobId], references: [id], onDelete: SetNull)
  importer    User?      @relation("PaymentImporter", fields: [importedBy], references: [id], onDelete: SetNull)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party       Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  creator     User                @relation("PaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     User?               @relation("PaymentUpdater", fields: [updatedBy], references: [id])
  allocations PaymentAllocation[]
  discount    PaymentDiscount?

  // Phase 6 — back-relation for Payroll.paymentId + EmployeeAdvance.paymentId
  payrolls         Payroll[]         @relation("PayrollPayment")
  employeeAdvances EmployeeAdvance[] @relation("AdvancePayment")

  // Phase 7 — Bank reconciliation (#147)
  reconciliationMatches ReconciliationMatch[] @relation("PaymentReconciliation")

  @@index([businessId, date])
  @@index([businessId, partyId])
  @@index([businessId, partyId, date]) // ledger window query
  @@index([businessId, type])
  @@index([businessId, mode])
  @@index([businessId, isDeleted])
  @@index([businessId, type, isDeleted, date])
  @@index([importJobId])
  @@index([businessId, importJobId])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Int // paise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Document @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model PaymentDiscount {
  id               String   @id @default(cuid())
  paymentId        String   @unique
  type             String // PERCENTAGE, FIXED
  // type=FIXED → valuePaise (paise) set, percentBps null
  // type=PERCENTAGE → percentBps (0..10000, basis points) set, valuePaise null
  // Enforced by CHECK constraint `payment_discount_value_xor` (migration A2).
  valuePaise       Int?
  percentBps       Int?
  calculatedAmount Int // paise
