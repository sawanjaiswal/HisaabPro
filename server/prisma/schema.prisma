generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// === Foundation models — expanded per feature via /f ===

model User {
  id               String  @id @default(cuid())
  phone            String  @unique
  name             String?
  email            String? @unique
  passwordHash     String?
  pinHash          String?
  biometricEnabled Boolean @default(false)
  isActive         Boolean @default(true)

  // Account lockout — Feature #64
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  accountLockedUntil  DateTime?

  // Admin suspension — Feature #7
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  // Referral wallet — Feature #3
  referredBy              String?
  referralBalance         Decimal   @default(0) @db.Decimal(12, 2)
  referralBalanceInReview Decimal   @default(0) @db.Decimal(12, 2)
  referralTotalEarned     Decimal   @default(0) @db.Decimal(12, 2)
  referralFraudFlags      Int       @default(0)
  walletFrozen            Boolean   @default(false)
  lastReferralAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-business — last active business (auto-loaded on login)
  lastActiveBusinessId String?
  lastActiveBusiness   Business? @relation("UserLastActiveBusiness", fields: [lastActiveBusinessId], references: [id], onDelete: SetNull)

  businessUsers      BusinessUser[]
  refreshTokens      RefreshToken[]
  stockMovements     StockMovement[]
  documentsCreated   Document[]         @relation("DocumentCreator")
  documentsUpdated   Document[]         @relation("DocumentUpdater")
  documentsDeleted   Document[]         @relation("DocumentDeleter")
  shareLogs          DocumentShareLog[]
  paymentsCreated    Payment[]          @relation("PaymentCreator")
  paymentsUpdated    Payment[]          @relation("PaymentUpdater")
  auditLogs          AuditLog[]
  appSettings        UserAppSettings?
  approvalsRequested ApprovalRequest[]  @relation("ApprovalRequester")
  approvalsReviewed  ApprovalRequest[]  @relation("ApprovalReviewer")

  // Referral relations
  referredByUser            User?                @relation("UserReferrals", fields: [referredBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referredUsers             User[]               @relation("UserReferrals")
  referralCode              ReferralCode?
  referralRewardsAsReferrer ReferralReward[]     @relation("ReferralRewardsReferrer")
  referralRewardsAsReferred ReferralReward[]     @relation("ReferralRewardsReferred")
  referralEventsAsReferrer  ReferralEvent[]      @relation("ReferralEventsReferrer")
  referralEventsAsReferred  ReferralEvent[]      @relation("ReferralEventsReferred")
  referralWithdrawals       ReferralWithdrawal[]
  couponRedemptions         CouponRedemption[]
  webauthnCredentials       WebAuthnCredential[]

  // Phase 3 — Accounting
  expensesCreated     Expense[]           @relation("ExpenseCreator")
  otherIncomesCreated OtherIncome[]       @relation("OtherIncomeCreator")
  stockVerifications  StockVerification[]

  // Phase 4 — Multi-Godown transfers
  godownTransfers GodownTransfer[]

  @@index([phone])
  @@index([referredBy])
  @@index([referralFraudFlags])
  @@index([lastReferralAt])
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  logoUrl            String?
  businessType       String   @default("general")
  currencyCode       String   @default("INR")
  financialYearStart Int      @default(4) // April
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // MSME compliance
  udyamNumber String? // UDYAM-XX-XX-XXXXXXX format

  // GST — Phase 2
  gstin             String?
  stateCode         String? // 2-digit, extracted from GSTIN pos 0-1
  compositionScheme Boolean @default(false)
  eInvoiceEnabled   Boolean @default(false)
  eWayBillEnabled   Boolean @default(false)
  turnoverSlab      String? // Tracks e-invoice threshold eligibility

  // GST Phase 2 — new fields (migration: 20260505190000_gst_phase_2_fields)
  gstEnabled         Boolean @default(false)
  taxPricingMode     String  @default("EXCLUSIVE") @db.VarChar(20) // EXCLUSIVE | INCLUSIVE
  gstDeclarationText String? @db.Text // null = use in-code default per SCOPE §8.4

  // Phase 2.2 — Batch tracking + Expiry policy (migration: 20260507160000_inventory_batches_columns)
  expiryAlertDays    Int?   @default(30) // 0 = no advance alerts; null = inherit default 30
  expiredBatchPolicy String @default("WARN_ONLY") // WARN_ONLY | HARD_BLOCK — independent of stockValidationMode

  businessUsers        BusinessUser[]
  parties              Party[]
  partyGroups          PartyGroup[]
  customFields         CustomFieldDefinition[]
  categories           Category[]
  units                Unit[]
  products             Product[]
  unitConversions      UnitConversion[]
  stockMovements       StockMovement[]
  inventorySetting     InventorySetting?
  documents            Document[]
  documentNumberSeries DocumentNumberSeries[]
  documentSettings     DocumentSettings?
  digitalSignature     DigitalSignature?
  termsTemplates       TermsAndConditionsTemplate[]
  payments             Payment[]
  paymentReminders     PaymentReminder[]
  reminderConfig       ReminderConfig?
  roles                Role[]
  staffInvites         StaffInvite[]
  transactionLock      TransactionLockConfig?
  approvals            ApprovalRequest[]
  auditLogs            AuditLog[]
  taxCategories        TaxCategory[]
  gstReturns           GstReturn[]
  gstReconciliations   GstReconciliation[]
  recurringInvoices    RecurringInvoice[]
  recurringRuns        RecurringInvoiceRun[]
  exchangeRates        ExchangeRate[]

  // Phase 3 — Accounting
  ledgerAccounts    LedgerAccount[]
  journalEntries    JournalEntry[]
  bankAccounts      BankAccount[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  otherIncomes      OtherIncome[]
  cheques           Cheque[]
  loanAccounts      LoanAccount[]
  fyClosures        FinancialYearClosure[]

  stockAlerts        StockAlert[]
  stockVerifications StockVerification[]

  // Phase 4 — Batch Tracking + Multi-Godown + Serial Numbers
  batches         Batch[]
  godowns         Godown[]
  godownStocks    GodownStock[]
  godownTransfers GodownTransfer[]
  serialNumbers   SerialNumber[]

  // Business-Verticals Phase 3 — Services jobs
  jobs Job[]

  // Business-Verticals Phase 4 — Bakery/tailor vertical
  customOrders CustomOrder[]

  // Payments & Collections Hub
  paymentLinks       PaymentLink[]
  promisesToPay      PromiseToPay[]
  reminderLogs       ReminderLog[]
  collectionCadences CollectionCadence[]

  usersLastActive User[]        @relation("UserLastActiveBusiness")
  subscription    Subscription?

  // Cash Register
  cashEntries CashEntry[]

  @@index([name])
}

model BusinessUser {
  id           String    @id @default(cuid())
  userId       String
  businessId   String
  role         String    @default("owner")
  roleId       String?
  isActive     Boolean   @default(true)
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  lastActiveAt DateTime?
  joinedAt     DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  roleRef  Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  context   String? // JSON: { purpose: 'registration'|'password_reset', name?, passwordHash? }

  @@index([phone, verified])
  @@index([expiresAt])
}

model IdempotencyLog {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Feedback {
  id         String   @id @default(cuid())
  userId     String?
  type       String // bug, feature, general
  message    String
  rating     Int?
  screenshot String? // base64 or URL
  metadata   Json? // device info, page, etc.
  status     String   @default("open") // open, reviewed, resolved
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
}

// === Party Management ===

model Party {
  id                 String    @id @default(cuid())
  businessId         String
  name               String
  phone              String?
  email              String?
  companyName        String?
  type               String    @default("CUSTOMER") // CUSTOMER, SUPPLIER, BOTH
  groupId            String?
  tags               String[]  @default([])
  gstin              String?
  stateCode          String? // 2-digit, extracted from GSTIN pos 0-1
  gstinVerified      Boolean   @default(false)
  gstinVerifiedAt    DateTime?
  compositionScheme  Boolean   @default(false)
  pan                String?
  creditLimit        Int       @default(0) // in paise, 0 = no limit
  creditLimitMode    String    @default("WARN") // WARN, BLOCK
  outstandingBalance Int       @default(0) // in paise, positive = receivable, negative = payable
  totalBusiness      Int       @default(0) // in paise, lifetime total
  lastTransactionAt  DateTime?
  notes              String?
  isActive           Boolean   @default(true)
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group             PartyGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addresses         PartyAddress[]
  customFieldValues PartyCustomFieldValue[]
  openingBalance    OpeningBalance?
  pricing           PartyPricing[]
  documents         Document[]
  payments          Payment[]
  paymentReminders  PaymentReminder[]
  jobs              Job[]
  customOrders      CustomOrder[]
  paymentLinks      PaymentLink[]
  promisesToPay     PromiseToPay[]
  reminderLogs      ReminderLog[]

  @@unique([businessId, phone])
  @@index([businessId, type, isActive])
  @@index([businessId, name])
  @@index([businessId, outstandingBalance])
  @@index([businessId, isDeleted])
  @@index([groupId])
}

model PartyAddress {
  id        String    @id @default(cuid())
  partyId   String
  label     String    @default("Default")
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  type      String    @default("BILLING") // BILLING, SHIPPING
  isDefault Boolean   @default(false)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, type])
  @@index([partyId, isDeleted])
}

model PartyGroup {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  color       String    @default("#6B7280")
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parties  Party[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model CustomFieldDefinition {
  id            String    @id @default(cuid())
  businessId    String
  name          String
  fieldType     String // TEXT, NUMBER, DATE, DROPDOWN
  options       String[]  @default([]) // for DROPDOWN type
  required      Boolean   @default(false)
  showOnInvoice Boolean   @default(false)
  entityType    String    @default("PARTY") // PARTY, PRODUCT, INVOICE
  sortOrder     Int       @default(0)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business      Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  values        PartyCustomFieldValue[]
  productValues ProductCustomFieldValue[]

  @@unique([businessId, name, entityType])
  @@index([businessId, entityType])
  @@index([businessId, isDeleted])
}

model PartyCustomFieldValue {
  id        String   @id @default(cuid())
  partyId   String
  fieldId   String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party                 @relation(fields: [partyId], references: [id], onDelete: Cascade)
  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([partyId, fieldId])
  @@index([fieldId])
}

model OpeningBalance {
  id        String    @id @default(cuid())
  partyId   String    @unique
  amount    Int // in paise
  type      String // RECEIVABLE, PAYABLE
  asOfDate  DateTime
  notes     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model PartyPricing {
  id        String    @id @default(cuid())
  partyId   String
  productId String
  price     Int // in paise
  minQty    Int       @default(1)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([partyId, productId])
  @@index([productId])
  @@index([partyId, isDeleted])
}

// === Inventory & Products ===

model Category {
  id         String    @id @default(cuid())
  businessId String
  name       String
  type       String    @default("CUSTOM") // PREDEFINED, CUSTOM
  color      String    @default("#6B7280")
  sortOrder  Int       @default(0)
  isHidden   Boolean   @default(false) // hide predefined without deleting
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model Unit {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  symbol         String
  type           String    @default("CUSTOM") // PREDEFINED, CUSTOM
  category       String    @default("OTHER") // WEIGHT, VOLUME, COUNT, LENGTH, AREA, SERVICE, PACKAGING, OTHER
  decimalAllowed Boolean   @default(true) // false for pcs/box, true for kg/ltr
  baseUnitId     String? // Self-ref: Box of 12 → pcs
  baseUnitFactor Float? // 1 box12 = 12 pcs
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  baseUnit        Unit?            @relation("UnitBase", fields: [baseUnitId], references: [id], onDelete: SetNull)
  derivedUnits    Unit[]           @relation("UnitBase")
  products        Product[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")

  @@unique([businessId, name])
  @@unique([businessId, symbol])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model UnitConversion {
  id         String    @id @default(cuid())
  businessId String
  fromUnitId String
  toUnitId   String
  factor     Float // 1 fromUnit = factor toUnits
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromUnit Unit     @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit   Unit     @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Restrict)

  @@unique([businessId, fromUnitId, toUnitId])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model Product {
  id                   String    @id @default(cuid())
  businessId           String
  name                 String
  sku                  String?
  categoryId           String?
  unitId               String
  salePrice            Int       @default(0) // in paise
  purchasePrice        Int? // in paise
  currentStock         Float     @default(0) // supports decimals for kg/ltr
  minStockLevel        Float     @default(0)
  stockValidation      String    @default("GLOBAL") // GLOBAL, WARN_ONLY, HARD_BLOCK
  hsnCode              String?
  sacCode              String?
  taxCategoryId        String? // FK → TaxCategory (default GST rate for this product)
  description          String?
  barcode              String? // optional barcode value (EAN13, CODE128, etc.)
  barcodeFormat        String? // CODE128, EAN13, EAN8, UPC, QR, CODE39
  status               String    @default("ACTIVE") // ACTIVE, INACTIVE
  // Feature #108 — Item Images
  imageUrl             String? // primary image URL
  images               String[]  @default([]) // up to 5 image URLs
  // Feature #109 — MOQ (min order quantity)
  moq                  Int?
  // Inventory Phase 2 — reorder threshold (null = not set; 0 = explicit zero)
  reorderQty           Float?
  // Inventory Phase 2 — weighted-average purchase cost (paise). Updated on every SAVED purchase.
  weightedAvgCostPaise BigInt    @default(0)
  // Feature #103 — Label Printing
  labelTemplate        String?   @default("standard") // "standard" | "compact" | "barcode-only"
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit              Unit                      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxCategory       TaxCategory?              @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  stockMovements    StockMovement[]
  customFieldValues ProductCustomFieldValue[]
  partyPricing      PartyPricing[]
  documentLineItems DocumentLineItem[]
  stockAlerts       StockAlert[]
  verificationItems StockVerificationItem[]

  // Phase 4 — Batch Tracking + Multi-Godown + Serial Numbers
  batches         Batch[]
  godownStocks    GodownStock[]
  godownTransfers GodownTransfer[]
  serialNumbers   SerialNumber[]

  // Business-Verticals Phase 3 — optional link from a JobItem to a catalog product
  jobItems JobItem[] @relation("JobItemProduct")

  // Business-Verticals Phase 4 — optional link from a CustomOrderItem to a catalog product
  customOrderItems CustomOrderItem[] @relation("CustomOrderItemProduct")

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@index([businessId, name])
  @@index([businessId, currentStock, minStockLevel])
  @@index([businessId, isDeleted])
}

model StockMovement {
  id              String   @id @default(cuid())
  businessId      String
  productId       String
  type            String // OPENING, SALE, PURCHASE, ADJUSTMENT_IN, ADJUSTMENT_OUT, RETURN_IN, RETURN_OUT, REVERSAL
  quantity        Float // positive = in, negative = out
  balanceAfter    Float
  reason          String? // DAMAGE, THEFT, AUDIT, GIFT, RETURN, OTHER
  customReason    String?
  notes           String?
  referenceType   String? // SALE_INVOICE, PURCHASE_INVOICE, CREDIT_NOTE, DEBIT_NOTE, ADJUSTMENT
  referenceId     String?
  referenceNumber String?
  movementDate    DateTime @default(now())
  createdBy       String
  createdAt       DateTime @default(now())

  // Phase 4 — Batch Tracking + Multi-Godown (nullable, backward-compatible)
  batchId  String?
  godownId String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  godown   Godown?  @relation(fields: [godownId], references: [id], onDelete: SetNull)

  // Immutable — no updatedAt
  @@index([productId, createdAt])
  @@index([businessId, movementDate])
  @@index([referenceType, referenceId])
  @@index([batchId])
  @@index([godownId])
}

model ProductCustomFieldValue {
  id        String   @id @default(cuid())
  productId String
  fieldId   String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldId])
  @@index([fieldId])
}

model InventorySetting {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  stockValidationMode    String   @default("WARN_ONLY") // WARN_ONLY, HARD_BLOCK
  skuPrefix              String   @default("PRD")
  skuAutoGenerate        Boolean  @default(true)
  skuNextCounter         Int      @default(1)
  lowStockAlertEnabled   Boolean  @default(true)
  lowStockAlertFrequency String   @default("DAILY") // ONCE, DAILY, EVERY_TIME
  decimalPrecisionQty    Int      @default(2)
  defaultCategoryId      String?
  defaultUnitId          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// === Invoicing & Documents ===

model Document {
  id         String @id @default(cuid())
  businessId String
  type       String // SALE_INVOICE, PURCHASE_INVOICE, ESTIMATE, PROFORMA, SALE_ORDER, PURCHASE_ORDER, DELIVERY_CHALLAN
  status     String @default("DRAFT") // DRAFT, SAVED, SHARED, CONVERTED, DELETED

  // Numbering
  documentNumber String? // Assigned on SAVE, null for DRAFT
  sequenceNumber Int?
  financialYear  String? // "2526" (April 2025 - March 2026)

  // Party
  partyId           String
  shippingAddressId String?

  // Dates
  documentDate DateTime
  dueDate      DateTime?
  paymentTerms String? // COD, NET_7, NET_15, NET_30, NET_60, NET_90, CUSTOM

  // Totals (PAISE — integer)
  subtotal               Int @default(0)
  totalDiscount          Int @default(0)
  totalAdditionalCharges Int @default(0)
  roundOff               Int @default(0)
  grandTotal             Int @default(0)

  // GST — Phase 2
  placeOfSupply     String? // 2-digit state code
  supplyType        String  @default("B2B") // B2B, B2C_LARGE, B2C_SMALL, EXPORT, SEZ
  isReverseCharge   Boolean @default(false)
  isComposite       Boolean @default(false)
  totalTaxableValue Int     @default(0) // paise — sum of line taxableValues
  totalCgst         Int     @default(0) // paise
  totalSgst         Int     @default(0) // paise
  totalIgst         Int     @default(0) // paise
  totalCess         Int     @default(0) // paise
  taxPricingMode    String  @default("EXCLUSIVE") @db.VarChar(20) // EXCLUSIVE | INCLUSIVE — GST Phase 2

  // TDS/TCS — Phase 2B (B2B invoice deductions)
  tdsRate   Int @default(0) // basis points
  tdsAmount Int @default(0) // paise
  tcsRate   Int @default(0) // basis points
  tcsAmount Int @default(0) // paise

  // Multi-currency — Phase 2E
  currencyCode         String @default("INR") @db.VarChar(3)
  exchangeRate         Int    @default(100) // rate * 100 (1 USD = 8400 means Rs 84.00)
  foreignCurrencyTotal Int    @default(0) // amount in foreign currency minor units

  // Profit
  totalCost     Int   @default(0)
  totalProfit   Int   @default(0)
  profitPercent Float @default(0)

  // Content
  notes              String? @db.Text
  termsAndConditions String? @db.Text
  includeSignature   Boolean @default(false)

  // Transport (Delivery Challan)
  vehicleNumber  String?
  driverName     String?
  transportNotes String?

  // Conversion chain
  sourceDocumentId String?   @unique
  sourceDocument   Document? @relation("DocumentConversion", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  convertedTo      Document? @relation("DocumentConversion")

  // Payment tracking (denormalized from payments)
  paidAmount Int @default(0)
  balanceDue Int @default(0)

  // Recycle bin / Soft delete
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  permanentDeleteAt DateTime?

  // Audit
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Offline sync
  clientId String? @unique

  // Relations
  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  creator  User      @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?     @relation("DocumentUpdater", fields: [updatedBy], references: [id])
  deleter  User?     @relation("DocumentDeleter", fields: [deletedBy], references: [id])
  // E-Compliance — Phase 2
  eInvoice EInvoice?
  eWayBill EWayBill?

  // Recurring — Phase 2
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  isRecurring        Boolean           @default(false) // true when used as a recurring template

  // Recurring run back-relation (populated when this doc was auto-generated)
  recurringRun RecurringInvoiceRun? @relation("RecurringRunDocument")

  // Credit/Debit Note link
  originalDocumentId String?
  creditDebitReason  String?    @db.VarChar(500)
  originalDocument   Document?  @relation("CreditDebitLink", fields: [originalDocumentId], references: [id], onDelete: SetNull)
  creditDebitNotes   Document[] @relation("CreditDebitLink")

  lineItems          DocumentLineItem[]
  additionalCharges  DocumentAdditionalCharge[]
  shareLogs          DocumentShareLog[]
  paymentAllocations PaymentAllocation[]
  paymentReminders   PaymentReminder[]
  serialNumbers      SerialNumber[]

  // Payments & Collections Hub
  paymentLinks  PaymentLink[]  @relation("PaymentLinkInvoice")
  promisesToPay PromiseToPay[] @relation("PtpInvoice")
  reminderLogs  ReminderLog[]  @relation("ReminderLogInvoice")

  // Business-Verticals Phase 3 — set when this Document was produced by converting a Job
  jobOrigin Job? @relation("JobInvoice")

  // Business-Verticals Phase 4 — set when this Document was produced by converting a CustomOrder
  customOrderOrigin CustomOrder? @relation("CustomOrderInvoice")

  @@unique([businessId, type, documentNumber])
  @@index([businessId, type, status])
  @@index([businessId, partyId])
  @@index([businessId, documentDate])
  @@index([businessId, isDeleted])
  @@index([permanentDeleteAt])
  @@index([clientId])
  @@index([recurringInvoiceId])
  @@index([originalDocumentId])
  @@index([businessId, type, status, documentDate])
  @@index([businessId, dueDate])
  @@index([businessId, balanceDue])
}

model DocumentLineItem {
  id         String @id @default(cuid())
  documentId String
  productId  String
  sortOrder  Int    @default(0)

  quantity       Float // supports decimals (kg/ltr)
  rate           Int // PAISE
  discountType   String @default("AMOUNT") // AMOUNT, PERCENTAGE
  discountValue  Int    @default(0) // paise for AMOUNT, basis points (x100) for PERCENTAGE
  discountAmount Int    @default(0) // calculated paise
  lineTotal      Int    @default(0) // (qty * rate) - discountAmount

  // GST — Phase 2 (all amounts in PAISE, rates in BASIS POINTS)
  taxCategoryId String?
  hsnCode       String?
  sacCode       String?
  taxableValue  Int     @default(0) // paise — equals lineTotal (taxable amount after discount)
  cgstRate      Int     @default(0) // basis points (e.g. 900 = 9%)
  cgstAmount    Int     @default(0) // paise
  sgstRate      Int     @default(0) // basis points
  sgstAmount    Int     @default(0) // paise
  igstRate      Int     @default(0) // basis points (e.g. 1800 = 18%)
  igstAmount    Int     @default(0) // paise
  cessRate      Int     @default(0) // basis points
  cessAmount    Int     @default(0) // paise

  // Snapshot at time of invoice
  purchasePrice Int   @default(0)
  profit        Int   @default(0)
  profitPercent Float @default(0)

  // Stock snapshot
  stockBefore Float @default(0)
  stockAfter  Float @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([productId])
}

model DocumentAdditionalCharge {
  id         String @id @default(cuid())
  documentId String
  name       String
  type       String @default("FIXED") // FIXED, PERCENTAGE
  value      Int    @default(0) // paise for FIXED, basis points for PERCENTAGE
  amount     Int    @default(0) // calculated paise
  sortOrder  Int    @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentShareLog {
  id             String   @id @default(cuid())
  documentId     String
  channel        String // WHATSAPP, EMAIL, PRINT
  format         String // PDF, JPG, PNG
  recipientPhone String?
  recipientEmail String?
  fileUrl        String?
  fileSize       Int?
  message        String?  @db.Text
  sentBy         String
  sentAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [sentBy], references: [id], onDelete: Restrict)

  @@index([documentId])
}

model DocumentNumberSeries {
  id            String @id @default(cuid())
  businessId    String
  documentType  String // SALE_INVOICE, PURCHASE_INVOICE, etc.
  financialYear String // "2526"

  prefix          String    @default("INV")
  suffix          String    @default("")
  separator       String    @default("-")
  paddingDigits   Int       @default(3)
  currentSequence Int       @default(0)
  startingNumber  Int       @default(1)
  resetOnNewYear  Boolean   @default(true)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, documentType, financialYear])
  @@index([businessId, isDeleted])
}

model DigitalSignature {
  id         String   @id @default(cuid())
  businessId String   @unique
  imageUrl   String
  autoApply  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model TermsAndConditionsTemplate {
  id         String    @id @default(cuid())
  businessId String
  name       String
  content    String    @db.Text
  isDefault  Boolean   @default(false)
  appliesTo  String[]  @default([]) // Document types this applies to
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model DocumentSettings {
  id                      String   @id @default(cuid())
  businessId              String   @unique
  defaultPaymentTerms     String   @default("COD")
  roundOffTo              String   @default("NEAREST_1") // NONE, NEAREST_1, NEAREST_050, NEAREST_010
  showProfitDuringBilling Boolean  @default(true)
  allowFutureDates        Boolean  @default(false)
  transactionLockDays     Int      @default(0)
  recycleBinRetentionDays Int      @default(30)
  autoShareOnSave         Boolean  @default(false)
  autoShareChannel        String   @default("WHATSAPP")
  autoShareFormat         String   @default("PDF")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // GST Phase 2 — new field (migration: 20260505190000_gst_phase_2_fields)
  taxPricingMode String @default("EXCLUSIVE") @db.VarChar(20) // EXCLUSIVE | INCLUSIVE

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// === Payment Tracking ===

model Payment {
  id              String    @id @default(cuid())
  offlineId       String?   @unique
  businessId      String
  type            String // PAYMENT_IN, PAYMENT_OUT
  partyId         String
  amount          Int // paise
  date            DateTime
  mode            String // CASH, UPI, BANK_TRANSFER, CHEQUE, NEFT_RTGS_IMPS, CREDIT_CARD, OTHER
  referenceNumber String?   @db.VarChar(100)
  notes           String?   @db.VarChar(500)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party       Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  creator     User                @relation("PaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     User?               @relation("PaymentUpdater", fields: [updatedBy], references: [id])
  allocations PaymentAllocation[]
  discount    PaymentDiscount?

  @@index([businessId, date])
  @@index([businessId, partyId])
  @@index([businessId, type])
  @@index([businessId, mode])
  @@index([businessId, isDeleted])
  @@index([businessId, type, isDeleted, date])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Int // paise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Document @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model PaymentDiscount {
  id               String   @id @default(cuid())
  paymentId        String   @unique
  type             String // PERCENTAGE, FIXED
  value            Float // percentage value or fixed paise
  calculatedAmount Int // paise
  reason           String?  @db.VarChar(200)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentReminder {
  id            String    @id @default(cuid())
  businessId    String
  partyId       String
  invoiceId     String?
  channel       String // WHATSAPP, SMS, PUSH
  status        String    @default("SCHEDULED")
  message       String    @db.Text
  scheduledAt   DateTime?
  sentAt        DateTime?
  failureReason String?   @db.VarChar(500)
  retryCount    Int       @default(0)
  isAutomatic   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice  Document? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, partyId])
  @@index([scheduledAt, status])
}

model ReminderConfig {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  enabled                Boolean  @default(true)
  autoRemindEnabled      Boolean  @default(false)
  frequencyDays          Int[]    @default([1, 3, 7])
  maxRemindersPerInvoice Int      @default(5)
  defaultChannel         String   @default("WHATSAPP")
  quietHoursStart        String   @default("21:00")
  quietHoursEnd          String   @default("09:00")
  whatsappTemplate       String?  @db.Text
  smsTemplate            String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// === Payments & Collections Hub ===

enum PromiseToPayStatus {
  OPEN
  KEPT
  BROKEN
  CANCELLED
}

enum PaymentLinkStatus {
  CREATED
  ACTIVE
  PAID
  PARTIALLY_PAID
  EXPIRED
  CANCELLED
  FAILED
}

enum ReminderChannel {
  WHATSAPP
  SMS
  PUSH
  EMAIL
}

enum ReminderDispatchStatus {
  QUEUED
  DISPATCHED
  DELIVERED
  FAILED
}

enum CadenceTrigger {
  ON_DUE_DATE
  AFTER_DUE_DAYS
  AFTER_LAST_REMINDER_DAYS
}

model PromiseToPay {
  id         String  @id @default(cuid())
  businessId String
  partyId    String
  invoiceId  String?

  amountPaise Int
  promiseDate DateTime
  status      PromiseToPayStatus @default(OPEN)
  notes       String?            @db.VarChar(500)

  keptAt       DateTime?
  brokenAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(500)

  satisfyingPaymentIds String[] @default([])

  clientId String? @unique

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  createdBy String
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice  Document? @relation("PtpInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, partyId])
  @@index([businessId, promiseDate, status])
  @@index([businessId, isDeleted])
  @@index([clientId])
}

model PaymentLink {
  id         String @id @default(cuid())
  businessId String
  invoiceId  String
  partyId    String

  razorpayLinkId String?           @unique
  shortUrl       String?
  amountPaise    Int
  currency       String            @default("INR") @db.VarChar(3)
  status         PaymentLinkStatus @default(CREATED)

  expireBy        DateTime
  expiredAt       DateTime?
  paidAt          DateTime?
  paidAmountPaise Int       @default(0)
  cancelledAt     DateTime?

  description    String?  @db.VarChar(280)
  notifyChannels String[] @default([])

  createIdempotencyKey String? @unique

  lastWebhookEvent String?   @db.VarChar(64)
  lastWebhookAt    DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  createdBy String
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoice  Document @relation("PaymentLinkInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([businessId, invoiceId])
  @@index([businessId, partyId])
  @@index([expireBy, status])
  @@index([businessId, isDeleted])
}

model ReminderLog {
  id         String  @id @default(cuid())
  businessId String
  partyId    String
  invoiceId  String?

  origin      String  @db.VarChar(20)
  bulkBatchId String? @db.VarChar(40)
  cadenceId   String?

  channel ReminderChannel
  status  ReminderDispatchStatus @default(QUEUED)

  renderedMessage String  @db.Text
  templateKey     String? @db.VarChar(40)

  recipientPhone String?   @db.VarChar(20)
  dispatchedAt   DateTime?
  failedAt       DateTime?
  failureReason  String?   @db.VarChar(500)

  snapshotOutstandingPaise Int

  createdBy String
  createdAt DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice  Document? @relation("ReminderLogInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId, partyId, createdAt])
  @@index([businessId, invoiceId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, bulkBatchId])
}

model CollectionCadence {
  id                String          @id @default(cuid())
  businessId        String
  name              String          @db.VarChar(80)
  enabled           Boolean         @default(false)
  trigger           CadenceTrigger
  triggerOffsetDays Int             @default(0)
  channel           ReminderChannel @default(WHATSAPP)
  templateKey       String          @db.VarChar(40)
  quietHoursStart   String          @default("21:00") @db.VarChar(5)
  quietHoursEnd     String          @default("09:00") @db.VarChar(5)

  filters Json @default("{}")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId, enabled])
}

// === Settings & Security ===

model Role {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  isDefault   Boolean   @default(false)
  priority    Int       @default(0)
  permissions String[]  @default([])
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessUsers BusinessUser[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isDeleted])
}

model StaffInvite {
  id         String    @id @default(cuid())
  businessId String
  name       String
  phone      String
  roleId     String?
  code       String    @unique
  status     String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, CANCELLED
  expiresAt  DateTime
  invitedBy  String
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, isDeleted])
  @@index([phone])
  @@index([code])
}

model TransactionLockConfig {
  id                          String   @id @default(cuid())
  businessId                  String   @unique
  lockAfterDays               Int?
  requireApprovalForEdit      Boolean  @default(false)
  requireApprovalForDelete    Boolean  @default(false)
  priceChangeThresholdPercent Float?
  discountThresholdPercent    Float?
  operationPinHash            String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id               String    @id @default(cuid())
  businessId       String
  type             String // EDIT_LOCKED_TRANSACTION, DELETE_TRANSACTION, PRICE_OVERRIDE, DISCOUNT_OVERRIDE
  entityType       String
  entityId         String
  requestedBy      String
  requestedChanges Json
  status           String    @default("PENDING") // PENDING, APPROVED, DENIED, EXPIRED
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requester User     @relation("ApprovalRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer  User?    @relation("ApprovalReviewer", fields: [reviewedBy], references: [id])

  @@index([businessId, status])
  @@index([requestedBy])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  action      String // CREATE, UPDATE, DELETE, RESTORE, LOCK_OVERRIDE, PIN_RESET, ROLE_CHANGE, APPROVAL_REQUEST, APPROVAL_RESPONSE
  entityType  String
  entityId    String
  entityLabel String?
  userId      String? // nullable: cron/system actors use systemActor instead
  systemActor String?  @db.VarChar(50) // MB-7: identifies cron job or system process
  changes     Json?
  reason      String?
  ipAddress   String?
  deviceInfo  String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Immutable — no updatedAt
  @@index([businessId, createdAt])
  @@index([businessId, entityType])
  @@index([userId])
}

// === Referral & Earn — Feature #3 ===

model ReferralCode {
  id                String   @id @default(cuid())
  userId            String   @unique
  code              String   @unique
  link              String
  totalReferrals    Int      @default(0)
  successfulRewards Int      @default(0)
  totalEarned       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId])
}

model ReferralEvent {
  id                String   @id @default(cuid())
  referrerId        String
  referredId        String
  eventType         String // signup, payment_success, refund_issued, reward_credited
  eventData         Json?
  ipAddress         String?
  deviceFingerprint String?
  userAgent         String?
  isSuspicious      Boolean  @default(false)
  suspiciousReason  String?
  createdAt         DateTime @default(now())

  referrer User @relation("ReferralEventsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralEventsReferred", fields: [referredId], references: [id], onDelete: Cascade)

  // Immutable — no updatedAt
  @@index([referrerId, eventType])
  @@index([referredId, eventType])
  @@index([referrerId, isSuspicious])
  @@index([isSuspicious, createdAt])
  @@index([createdAt])
}

model ReferralReward {
  id             String    @id @default(cuid())
  referrerId     String
  referredId     String
  amount         Decimal   @db.Decimal(10, 2)
  status         String // in_review, approved, withdrawn, clawed_back
  eligibleAt     DateTime?
  approvedAt     DateTime?
  withdrawnAt    DateTime?
  clawedBackAt   DateTime?
  clawBackReason String?
  withdrawalId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referrer   User                @relation("ReferralRewardsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User                @relation("ReferralRewardsReferred", fields: [referredId], references: [id], onDelete: Cascade)
  withdrawal ReferralWithdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([referrerId, status])
  @@index([status, eligibleAt])
}

model ReferralWithdrawal {
  id            String    @id @default(cuid())
  userId        String
  amount        Decimal   @db.Decimal(10, 2)
  upiId         String
  status        String // pending, approved, rejected, failed, processing
  statusReason  String?
  autoApproved  Boolean   @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  processedAt   DateTime?
  transactionId String?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards ReferralReward[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model UserAppSettings {
  id                 String    @id @default(cuid())
  userId             String    @unique
  dateFormat         String    @default("DD/MM/YYYY")
  pinEnabled         Boolean   @default(false)
  pinHash            String?
  pinAttempts        Int       @default(0)
  pinLockedUntil     DateTime?
  biometricEnabled   Boolean   @default(false)
  calculatorPosition String    @default("BOTTOM_RIGHT")
  language           String    @default("en")
  theme              String    @default("light")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === Admin Panel ===

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponAppliesTo {
  FIRST_CYCLE
  ALL_CYCLES
  ONE_TIME
}

/// Platform admin accounts — separate from regular User table
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             AdminRole @default(ADMIN)
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // TOTP secret (encrypted at rest)

  // Security tracking
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  accountLockedUntil  DateTime?
  lastFailedLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions        AdminAction[]
  couponsCreated Coupon[]

  @@index([email])
  @@index([role, isActive])
}

/// Immutable audit trail — every admin action is recorded here
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String // SUSPEND_USER, UNSUSPEND_USER, VIEW_USER, UPDATE_SETTINGS, LOGIN, LOGOUT
  targetType String? // USER, BUSINESS, SETTINGS
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  // Immutable — no updatedAt
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// User suspension records — tracks who suspended whom and why
model UserSuspension {
  id          String    @id @default(cuid())
  userId      String    @unique
  suspendedBy String // AdminUser.id
  reason      String
  notes       String?
  suspendedAt DateTime  @default(now())
  liftedAt    DateTime?
  liftedBy    String? // AdminUser.id
  liftNotes   String?

  @@index([userId])
  @@index([suspendedBy])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 2 — GST & Compliance
// ═══════════════════════════════════════════════════════════════════════════════

/// Tax rate category — "GST 18%", "GST 5%", "Exempt", etc.
model TaxCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String // "GST 18%", "GST 5%", "Exempt"
  rate       Int       @default(0) // basis points (1800 = 18.00%)
  cessRate   Int       @default(0) // basis points for additional cess
  cessType   String    @default("PERCENTAGE") // PERCENTAGE, FIXED_PER_UNIT
  hsnCode    String? // Default HSN for this category
  sacCode    String? // Default SAC for this category
  isDefault  Boolean   @default(false) // System-created defaults (0%, 5%, 12%, 18%, 28%)
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, isDeleted])
}

/// Pre-seeded HSN/SAC code database (~12K records, read-only)
model HsnCode {
  code           String  @id // 4-8 digit HSN code
  description    String
  chapter        String? // 2-digit chapter (first 2 digits)
  defaultRate    Int     @default(0) // basis points — default GST rate
  cessApplicable Boolean @default(false)
  cessRate       Int     @default(0) // basis points
  uqc            String  @default("NOS") @db.VarChar(10) // Unit Quantity Code per CGST — GST Phase 2

  @@index([chapter])
  @@index([description])
}

/// E-Invoice record — IRN + QR from NIC IRP portal
model EInvoice {
  id            String    @id @default(cuid())
  documentId    String    @unique
  irn           String    @unique // 64-char hash from NIC
  ackNumber     String // Acknowledgement number
  ackDate       DateTime
  qrCodeData    String    @db.Text // Base64 or raw QR data
  signedInvoice Json // Full signed invoice JSON from NIC
  status        String    @default("GENERATED") // GENERATED, CANCELLED
  cancelReason  String?
  cancelledAt   DateTime?
  rawResponse   Json? // Full NIC response for debugging
  createdAt     DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([status])
}

/// E-Way Bill record
model EWayBill {
  id              String    @id @default(cuid())
  documentId      String    @unique
  ewbNumber       String    @unique
  ewbDate         DateTime
  validUpto       DateTime
  transportMode   String    @default("ROAD") // ROAD, RAIL, AIR, SHIP
  transporterId   String?
  transporterName String?
  vehicleNumber   String?
  vehicleType     String? // REGULAR, ODC (over-dimensional cargo)
  distance        Int       @default(0) // kilometers
  fromPincode     String
  toPincode       String
  status          String    @default("ACTIVE") // ACTIVE, CANCELLED, EXTENDED
  cancelReason    String?
  cancelledAt     DateTime?
  partBUpdates    Json      @default("[]") // Array of vehicle change records
  createdAt       DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([status])
  @@index([ewbNumber])
}

/// GST return filing tracker
model GstReturn {
  id                String    @id @default(cuid())
  businessId        String
  period            String // "2026-01" (YYYY-MM)
  returnType        String // GSTR1, GSTR3B, GSTR9
  status            String    @default("DRAFT") // DRAFT, EXPORTED, FILED
  filedAt           DateTime?
  jsonData          Json? // Exported JSON data
  summary           Json? // Aggregated summary (tax totals, counts)
  invoiceCount      Int       @default(0)
  totalTaxableValue Int       @default(0) // paise
  totalTax          Int       @default(0) // paise
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, period, returnType])
  @@index([businessId, returnType])
}

// ─── GSTR-1 Reconciliation — Phase 2E ───────────────────────────────────────

model GstReconciliation {
  id         String @id @default(cuid())
  businessId String
  period     String // YYYY-MM
  reconType  String // GSTR1_VS_BOOKS, GSTR2A_VS_BOOKS, GSTR2B_VS_BOOKS
  status     String @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED

  // Summary counts
  totalInvoices      Int @default(0)
  matchedCount       Int @default(0)
  mismatchedCount    Int @default(0)
  missingInGstrCount Int @default(0)
  extraInGstrCount   Int @default(0)

  // Summary amounts (paise)
  totalBookValue  Int @default(0)
  totalGstrValue  Int @default(0)
  differenceValue Int @default(0)

  // The uploaded GSTR data (JSON blob)
  gstrData Json?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries  GstReconciliationEntry[]

  @@unique([businessId, period, reconType])
  @@index([businessId, period])
}

model GstReconciliationEntry {
  id               String @id @default(cuid())
  reconciliationId String

  // Our system data
  documentId       String?
  documentNumber   String?
  documentDate     DateTime?
  partyGstin       String?   @db.VarChar(15)
  partyName        String?
  bookTaxableValue Int       @default(0) // paise
  bookTaxAmount    Int       @default(0) // paise

  // GSTR portal data
  gstrInvoiceNumber String?
  gstrInvoiceDate   DateTime?
  gstrTaxableValue  Int       @default(0) // paise
  gstrTaxAmount     Int       @default(0) // paise

  // Reconciliation result
  matchStatus      String // MATCHED, MISMATCHED, MISSING_IN_GSTR, EXTRA_IN_GSTR
  taxableValueDiff Int    @default(0) // paise (book - gstr)
  taxAmountDiff    Int    @default(0) // paise

  reconciliation GstReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, matchStatus])
}

/// Recurring invoice template — auto-generates invoices on schedule
model RecurringInvoice {
  id                 String    @id @default(cuid())
  businessId         String
  templateDocumentId String // Source document used as template
  partyId            String
  frequency          String // DAILY|WEEKLY|MONTHLY|QUARTERLY|YEARLY
  startDate          DateTime
  endDate            DateTime?
  nextRunDate        DateTime
  dayOfMonth         Int? // 1-28 for MONTHLY
  dayOfWeek          Int? // 0-6 for WEEKLY (0 = Sunday)
  autoSend           Boolean   @default(false)
  status             String    @default("ACTIVE") // ACTIVE|PAUSED|COMPLETED
  generatedCount     Int       @default(0)
  lastGeneratedAt    DateTime?
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Phase 1 additions — all nullable/defaulted for safe additive migration
  name              String?   @db.VarChar(120)
  autoPaymentLink   Boolean   @default(false)
  autoReminder      Boolean   @default(false)
  lastFailureReason String?   @db.VarChar(500)
  cancelledAt       DateTime?
  cancelledBy       String?
  createdBy         String? // userId; nullable for pre-existing rows
  updatedBy         String?
  claimedAt         DateTime? // cron claim watermark
  claimedBy         String?   @db.VarChar(80) // worker id (hostname:pid)

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documents Document[]
  runs      RecurringInvoiceRun[]

  @@index([businessId, status])
  @@index([nextRunDate, status])
  @@index([businessId, isDeleted])
  @@index([businessId, partyId])
  @@index([status, claimedAt])
}

/// One execution of a recurring invoice schedule
model RecurringInvoiceRun {
  id                  String    @id @default(cuid())
  recurringInvoiceId  String
  businessId          String
  scheduledFor        DateTime // the original due date
  ranAt               DateTime  @default(now())
  status              String // SUCCESS|SUCCESS_PARTIAL|FAILED|SKIPPED
  generatedDocumentId String?   @unique
  paymentLinkId       String?
  idempotencyKey      String // {recurringId}_{scheduledFor_YYYYMMDD}
  errorMessage        String?   @db.VarChar(500)
  warning             String?   @db.VarChar(120) // autoSend_skipped_no_phone, paymentLink_failed, gstin_mismatch, …
  retryCount          Int       @default(0)
  triggeredBy         String // "cron" | userId
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())

  recurringInvoice  RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  generatedDocument Document?        @relation("RecurringRunDocument", fields: [generatedDocumentId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([recurringInvoiceId, ranAt(sort: Desc)])
  @@index([businessId, status])
  @@index([scheduledFor, status])
}

// ---------------------------------------------------------------------------
// Multi-Currency — Phase 2E
// ---------------------------------------------------------------------------

model ExchangeRate {
  id            String   @id @default(cuid())
  businessId    String
  fromCurrency  String   @db.VarChar(3)
  toCurrency    String   @default("INR") @db.VarChar(3)
  rate          Int // rate * 10000 (e.g., 1 USD = 84.5678 INR → 845678)
  effectiveDate DateTime
  source        String   @default("MANUAL") // MANUAL, API
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, fromCurrency, toCurrency, effectiveDate])
  @@index([businessId, fromCurrency, effectiveDate])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 3 — Accounting & Finance
// ═══════════════════════════════════════════════════════════════════════════════

/// Ledger Account — Chart of Accounts node
/// Every account belongs to one of: ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
/// Sub-types give finer classification (BANK, CASH, RECEIVABLE, PAYABLE, etc.)
model LedgerAccount {
  id            String    @id @default(cuid())
  businessId    String
  code          String // "1000", "2000", etc. — user-visible account code
  name          String // "Cash in Hand", "Sales", "HDFC Current A/c"
  type          String // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  subType       String? // BANK, CASH, RECEIVABLE, PAYABLE, TAX, INVENTORY, FIXED_ASSET, CAPITAL, REVENUE, PURCHASE, DIRECT_EXPENSE, INDIRECT_EXPENSE, LOAN
  parentId      String? // For tree hierarchy
  description   String?
  isSystem      Boolean   @default(false) // System-created (cannot delete)
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  // Running balance (paise) — updated on each journal entry post
  // Positive = debit-normal for ASSET/EXPENSE, credit-normal for LIABILITY/EQUITY/INCOME
  balance       Int       @default(0)
  // Link to bank account (if subType=BANK)
  bankAccountId String?   @unique
  // Link to party (if subType=RECEIVABLE or PAYABLE)
  partyId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent       LedgerAccount?     @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     LedgerAccount[]    @relation("AccountHierarchy")
  bankAccount  BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  journalLines JournalEntryLine[]

  @@unique([businessId, code])
  @@index([businessId, type, isActive])
  @@index([businessId, subType])
  @@index([businessId, isDeleted])
  @@index([parentId])
  @@index([partyId])
}

/// Journal Entry — the atomic unit of double-entry accounting
/// Every financial event (invoice, payment, expense, adjustment) creates one
model JournalEntry {
  id           String    @id @default(cuid())
  businessId   String
  entryNumber  String // Auto-generated: "JE-2526-001"
  date         DateTime
  narration    String?   @db.Text
  type         String // SALES, PURCHASE, RECEIPT, PAYMENT, CONTRA, JOURNAL, EXPENSE, CREDIT_NOTE, DEBIT_NOTE, OPENING
  status       String    @default("DRAFT") // DRAFT, POSTED, VOID
  // Source reference — what created this entry
  sourceType   String? // DOCUMENT, PAYMENT, EXPENSE, MANUAL, OPENING, FY_CLOSURE
  sourceId     String? // ID of the source record
  sourceNumber String? // Human-readable ref (INV-2526-001, PAY-001)
  // Totals (paise) — must be equal for valid entry
  totalDebit   Int       @default(0)
  totalCredit  Int       @default(0)
  // Void info
  voidedAt     DateTime?
  voidedBy     String?
  voidReason   String?
  // Audit
  createdBy    String
  postedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines    JournalEntryLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId, date])
  @@index([businessId, type])
  @@index([businessId, status])
  @@index([sourceType, sourceId])
}

/// Journal Entry Line — individual debit or credit within an entry
model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Int      @default(0) // paise — one of debit/credit must be > 0
  credit         Int      @default(0) // paise
  narration      String? // Line-level note
  partyId        String? // For receivable/payable tracking
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([partyId])
}

/// Bank Account — linked to a LedgerAccount with subType=BANK
model BankAccount {
  id             String    @id @default(cuid())
  businessId     String
  bankName       String
  accountNumber  String
  ifscCode       String?
  branchName     String?
  accountType    String    @default("CURRENT") // CURRENT, SAVINGS, OD, CC
  openingBalance Int       @default(0) // paise
  currentBalance Int       @default(0) // paise (updated on transactions)
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount?
  cheques       Cheque[]

  @@unique([businessId, accountNumber])
  @@index([businessId, isActive])
  @@index([businessId, isDeleted])
}

/// Expense record — with category, receipt, and journal entry auto-posting
model Expense {
  id              String    @id @default(cuid())
  businessId      String
  categoryId      String
  amount          Int // paise
  date            DateTime
  paymentMode     String // CASH, UPI, BANK_TRANSFER, CHEQUE, CREDIT_CARD, OTHER
  bankAccountId   String? // if paid from bank
  partyId         String? // vendor/supplier
  referenceNumber String?   @db.VarChar(100)
  notes           String?   @db.Text
  receiptUrl      String? // attached receipt image
  isRecurring     Boolean   @default(false)
  // GST on expense
  gstApplicable   Boolean   @default(false)
  gstRate         Int       @default(0) // basis points
  gstAmount       Int       @default(0) // paise
  // Journal entry link
  journalEntryId  String?   @unique
  // Soft delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser User            @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([businessId, date])
  @@index([businessId, categoryId])
  @@index([businessId, isDeleted])
  @@index([businessId, isDeleted, paymentMode])
}

/// Expense Category — user-configurable with system defaults
model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String
  icon       String? // emoji or icon name
  color      String    @default("#6B7280")
  isSystem   Boolean   @default(false) // Rent, Salary, Utilities, etc.
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, isDeleted])
}

/// Other Income — interest, rent, misc income that's not from sales
model OtherIncome {
  id              String    @id @default(cuid())
  businessId      String
  category        String // INTEREST, RENT, COMMISSION, DISCOUNT_RECEIVED, MISCELLANEOUS
  amount          Int // paise
  date            DateTime
  paymentMode     String // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  bankAccountId   String?
  partyId         String?
  referenceNumber String?   @db.VarChar(100)
  notes           String?   @db.Text
  journalEntryId  String?   @unique
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("OtherIncomeCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([businessId, date])
  @@index([businessId, category])
  @@index([businessId, isDeleted])
}

/// Cheque — issued or received, with clearance tracking
model Cheque {
  id              String    @id @default(cuid())
  businessId      String
  type            String // ISSUED, RECEIVED
  chequeNumber    String
  bankAccountId   String
  partyId         String?
  amount          Int // paise
  date            DateTime // cheque date
  status          String    @default("PENDING") // PENDING, CLEARED, BOUNCED, CANCELLED, RETURNED
  clearanceDate   DateTime?
  bouncedAt       DateTime?
  bounceCharges   Int       @default(0) // paise
  bounceReason    String?
  referenceNumber String?   @db.VarChar(100)
  notes           String?
  journalEntryId  String?   @unique
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([businessId, type])
  @@index([businessId, date])
  @@index([businessId, isDeleted])
  @@index([bankAccountId])
}

/// Loan Account — track loans given/taken with EMI and interest
model LoanAccount {
  id                String    @id @default(cuid())
  businessId        String
  type              String // LOAN_GIVEN, LOAN_TAKEN
  partyId           String?
  loanName          String
  principalAmount   Int // paise
  interestRate      Int       @default(0) // basis points annual (1200 = 12%)
  tenure            Int? // months
  emiAmount         Int? // paise (monthly EMI)
  startDate         DateTime
  endDate           DateTime?
  outstandingAmount Int       @default(0) // paise — remaining principal
  totalInterestPaid Int       @default(0) // paise
  status            String    @default("ACTIVE") // ACTIVE, CLOSED, DEFAULTED
  journalEntryId    String?   @unique // opening entry
  notes             String?   @db.Text
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions LoanTransaction[]

  @@index([businessId, type, status])
  @@index([businessId, isDeleted])
}

/// Loan Transaction — EMI payment, interest charge, prepayment
model LoanTransaction {
  id              String   @id @default(cuid())
  loanAccountId   String
  type            String // EMI, INTEREST, PREPAYMENT, DISBURSEMENT, CLOSURE
  amount          Int // paise (total)
  principalAmount Int      @default(0) // paise (principal portion)
  interestAmount  Int      @default(0) // paise (interest portion)
  date            DateTime
  journalEntryId  String?  @unique
  notes           String?
  createdAt       DateTime @default(now())

  loanAccount LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)

  @@index([loanAccountId, date])
}

/// Financial Year Closure record
model FinancialYearClosure {
  id               String   @id @default(cuid())
  businessId       String
  financialYear    String // "2526" = April 2025 – March 2026
  closedAt         DateTime
  closedBy         String
  retainedEarnings Int      @default(0) // paise — P&L carried to Balance Sheet
  journalEntryId   String?  @unique // closing entry
  status           String   @default("CLOSED") // CLOSED, REOPENED
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, financialYear])
}

// === Coupon / Discount Code System — Feature #96 ===

/// Platform-level coupon for HisaabPro subscriptions
model Coupon {
  id                String          @id @default(cuid())
  code              String          @unique
  description       String?
  discountType      DiscountType
  discountValue     Int // Basis points for PERCENTAGE (2000 = 20%), paise for FIXED
  maxUses           Int? // null = unlimited
  usageCount        Int             @default(0)
  maxUsesPerUser    Int             @default(1)
  minPurchaseAmount Int? // paise, nullable
  validFrom         DateTime
  validUntil        DateTime? // null = no expiry
  isActive          Boolean         @default(true)
  appliesTo         CouponAppliesTo
  planFilter        String[]        @default([]) // Plan IDs, empty = all plans
  razorpayOfferId   String? // Linked Razorpay offer, null until synced
  metadata          Json            @default("{}")
  createdBy         String // AdminUser ID
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  creator     AdminUser          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  redemptions CouponRedemption[]

  @@index([isActive, validFrom, validUntil])
  @@index([code])
}

/// Tracks each coupon redemption by a user
model CouponRedemption {
  id                     String   @id @default(cuid())
  couponId               String
  userId                 String
  discountApplied        Int // paise — actual discount amount
  planId                 String? // Which plan was purchased
  razorpaySubscriptionId String? // Razorpay sub ID
  redeemedAt             DateTime @default(now())
  metadata               Json     @default("{}")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
}

// === WebAuthn / Biometric Auth — Feature #59 ===

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique // base64url-encoded credential ID from browser
  publicKey    String // base64url-encoded SPKI public key
  algorithm    Int // COSE algorithm ID: -7 (ES256) or -257 (RS256)
  signCount    Int       @default(0)
  deviceName   String? // e.g., "Pixel 8", "iPhone 15"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === Stock Alerts — Feature #47 ===

model StockAlert {
  id             String    @id @default(cuid())
  businessId     String
  productId      String
  alertType      String    @default("LOW_STOCK") // LOW_STOCK, OUT_OF_STOCK, EXPIRY_NEAR, EXPIRY_PASSED
  threshold      Float // quantity that triggered the alert
  currentQty     Float // quantity at time of alert
  status         String    @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  // Phase 2.2 — link to a specific batch for EXPIRY_NEAR / EXPIRY_PASSED rows
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([productId, status])
  @@index([businessId, batchId, alertType, status]) // cron dedupe + auto-resolve
}

// === Stock Verification — Feature #111 ===

model StockVerification {
  id          String    @id @default(cuid())
  businessId  String
  verifiedBy  String
  status      String    @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, FINALIZED
  notes       String?
  completedAt DateTime?
  finalizedAt DateTime?
  finalizedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User                    @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)
  items    StockVerificationItem[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model StockVerificationItem {
  id             String  @id @default(cuid())
  verificationId String
  productId      String
  systemQuantity Float // what the system says (at time of snapshot)
  actualQuantity Float? // what was physically counted
  discrepancy    Float? // actualQuantity - systemQuantity
  adjusted       Boolean @default(false)
  notes          String?

  // Phase 2.2 — optional batch reference (null = product-level count)
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  verification StockVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([verificationId])
  @@index([productId])
  @@index([batchId])
}

// === Phase 4 — Serial Number Tracking (#100) ===

model SerialNumber {
  id               String    @id @default(cuid())
  businessId       String
  productId        String
  serialNumber     String
  status           String    @default("AVAILABLE") // AVAILABLE, SOLD, RETURNED, DAMAGED, WARRANTY
  batchId          String?
  godownId         String?
  soldInDocumentId String?
  soldAt           DateTime?
  notes            String?
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  godown         Godown?   @relation(fields: [godownId], references: [id], onDelete: SetNull)
  soldInDocument Document? @relation(fields: [soldInDocumentId], references: [id], onDelete: SetNull)

  @@unique([businessId, serialNumber])
  @@index([businessId, productId, status])
  @@index([businessId, status])
  @@index([businessId, isDeleted])
  @@index([productId])
  @@index([soldInDocumentId])
}

// === Phase 4 — Batch Tracking (#99 Batch Tracking + #105 Expiry Alerts) ===

model Batch {
  id                String    @id @default(cuid())
  businessId        String
  productId         String
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  costPrice         Int? // paise
  salePrice         Int? // paise — batch-specific override
  currentStock      Float     @default(0)
  notes             String?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements    StockMovement[]
  godownStocks      GodownStock[]
  godownTransfers   GodownTransfer[]
  serialNumbers     SerialNumber[]
  stockAlerts       StockAlert[] // Phase 2.2 — expiry alerts linked to this batch
  verificationItems StockVerificationItem[] // Phase 2.2 — per-batch verification counts

  @@unique([businessId, productId, batchNumber])
  @@index([businessId, productId])
  @@index([businessId, expiryDate])
  @@index([productId, isDeleted])
  @@index([productId, expiryDate]) // FEFO selection — mirrors Batch_productId_expiryDate_idx CONCURRENTLY index
}

// === Phase 4 — Multi-Godown (#101 Multi-Godown) ===

model Godown {
  id         String    @id @default(cuid())
  businessId String
  name       String
  address    String?
  isDefault  Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockLocations GodownStock[]
  stockMovements StockMovement[]
  transfersFrom  GodownTransfer[] @relation("TransferFrom")
  transfersTo    GodownTransfer[] @relation("TransferTo")
  serialNumbers  SerialNumber[]

  @@unique([businessId, name])
  @@index([businessId, isDeleted])
}

model GodownStock {
  id         String  @id @default(cuid())
  businessId String
  productId  String
  godownId   String
  batchId    String?
  quantity   Float   @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  godown   Godown   @relation(fields: [godownId], references: [id], onDelete: Restrict)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([productId, godownId, batchId])
  @@index([businessId, godownId])
  @@index([productId, godownId])
}

model GodownTransfer {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  batchId       String?
  fromGodownId  String
  toGodownId    String
  quantity      Int
  notes         String?
  transferredBy String
  createdAt     DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch      Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  fromGodown Godown   @relation("TransferFrom", fields: [fromGodownId], references: [id], onDelete: Restrict)
  toGodown   Godown   @relation("TransferTo", fields: [toGodownId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [transferredBy], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([productId])
  @@index([fromGodownId])
  @@index([toGodownId])
}

// === Subscription — Feature: plan gating ===

model Subscription {
  id             String    @id @default(cuid())
  businessId     String    @unique
  planTier       String    @default("FREE") // FREE, PRO, BUSINESS
  status         String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, TRIALING
  startDate      DateTime  @default(now())
  expiresAt      DateTime?
  razorpaySubId  String? // Razorpay subscription ID
  razorpayPlanId String? // Razorpay plan ID
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([status])
}

// ─── Business-Verticals Phase 3 — Jobs (services vertical) ────────────────────

enum JobStatus {
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  CANCELLED
}

model Job {
  id         String @id @default(cuid())
  businessId String
  partyId    String

  // Numbering — assigned on first SAVE (status leaves QUOTED). Independent series: "JOB-25-26-0001".
  jobNumber      String?
  sequenceNumber Int?
  financialYear  String?

  // Content
  title       String    @db.VarChar(200)
  description String?   @db.Text
  status      JobStatus @default(QUOTED)

  // Schedule
  scheduledAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(500)

  // Totals (PAISE — integer, matches Document)
  subtotalPaise Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  // Forward link to the SALE_INVOICE produced by convert-to-invoice
  invoiceId String? @unique

  // Offline sync (matches Document.clientId pattern)
  clientId String? @unique

  // Soft delete (matches Document/Party convention)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Audit
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice  Document? @relation("JobInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  items    JobItem[]

  @@unique([businessId, jobNumber])
  @@index([businessId, status])
  @@index([businessId, partyId])
  @@index([businessId, scheduledAt])
  @@index([businessId, isDeleted])
  @@index([clientId])
}

model JobItem {
  id        String @id @default(cuid())
  jobId     String
  sortOrder Int    @default(0)

  // Optional product link — services often have no SKU.
  productId String?

  description String @db.VarChar(500)

  // Quantity matches HP convention: Decimal(12,3) for fractional units (hours, kg).
  quantity Decimal @db.Decimal(12, 3)

  // Money — PAISE integers, matches DocumentLineItem.
  ratePaise     Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product Product? @relation("JobItemProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([productId])
}

// ─── Business-Verticals Phase 4 — Custom Orders (bakery / tailor verticals) ────

enum CustomOrderStatus {
  RECEIVED // taken from customer; advance optional
  IN_PRODUCTION // shop has started work
  READY // ready for pickup / dispatch
  DELIVERED // handed over; not yet billed
  INVOICED // converted to a SALE_INVOICE Document
  CANCELLED
}

model CustomOrder {
  id         String @id @default(cuid())
  businessId String
  partyId    String

  // Numbering — assigned on create. Independent series: "ORD-25-26-0001".
  orderNumber    String?
  sequenceNumber Int?
  financialYear  String?

  // Content
  title  String            @db.VarChar(200)
  notes  String?           @db.Text
  status CustomOrderStatus @default(RECEIVED)

  // Delivery
  deliveryAt      DateTime?
  deliverySlot    String?   @db.VarChar(40)
  deliveryAddress String?   @db.VarChar(500)
  deliveredAt     DateTime?

  // Lifecycle audit timestamps
  productionStartedAt DateTime?
  readyAt             DateTime?
  cancelledAt         DateTime?
  cancelReason        String?   @db.VarChar(500)

  // Totals (PAISE — Int, matches Document/Job)
  subtotalPaise Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  // Advance — denormalised sum of CustomOrderAdvance rows
  advancePaise Int @default(0)

  // balancePaise = totalPaise - advancePaise. Persisted for queryability.
  balancePaise Int @default(0)

  // Forward link to the SALE_INVOICE produced by convert-to-invoice
  invoiceId String? @unique

  // Offline sync (matches Document.clientId / Job.clientId pattern)
  clientId String? @unique

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Audit
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  party    Party                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice  Document?            @relation("CustomOrderInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  items    CustomOrderItem[]
  advances CustomOrderAdvance[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@index([businessId, partyId])
  @@index([businessId, deliveryAt])
  @@index([businessId, isDeleted])
  @@index([clientId])
}

model CustomOrderItem {
  id            String @id @default(cuid())
  customOrderId String
  sortOrder     Int    @default(0)

  // Optional product link — bakery/tailor items often have no SKU.
  productId String?

  description String @db.VarChar(500)

  // Per-item spec JSON (free-form, driven by CustomFieldDefinition rows)
  spec Json?

  // Quantity: Decimal(12,3) for fractional units
  quantity Decimal @db.Decimal(12, 3)

  // Money — PAISE Int
  ratePaise     Int @default(0)
  discountPaise Int @default(0)
  totalPaise    Int @default(0)

  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  product     Product?    @relation("CustomOrderItemProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([customOrderId])
  @@index([productId])
}

model CustomOrderAdvance {
  id            String @id @default(cuid())
  customOrderId String

  // Money received against this order before the invoice exists
  amountPaise Int

  // Payment method — string to avoid enum coupling; validated in Zod
  method     String   @db.VarChar(40)
  reference  String?  @db.VarChar(120)
  receivedAt DateTime @default(now())
  notes      String?  @db.VarChar(500)

  // Stamped with the Payment.id when the order converts to invoice
  paymentId String?

  // Audit
  createdBy String
  createdAt DateTime @default(now())

  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Cash Register — Phase 1
// ═══════════════════════════════════════════════════════════════════════════════

enum CashEntryDirection {
  IN
  OUT
}

enum CashEntryEventType {
  CREATED
  EDITED
  VOIDED
  RESTORED
  HARD_DELETED
}

model CashEntry {
  id              String             @id @default(cuid())
  businessId      String
  expression      String // raw expression e.g. "100+50*2"
  amountPaise     BigInt // server-evaluated, never client-trusted
  direction       CashEntryDirection
  note            String?
  createdBy       String // BusinessUser.id
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  voidedAt        DateTime?
  voidedBy        String? // BusinessUser.id
  voidReason      String?
  idempotencyKey  String? // X-Idempotency-Key header value
  ledgerJournalId String? // Phase 2: link to JournalEntry

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   CashEntryEvent[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, voidedAt])
  @@index([businessId, direction, createdAt(sort: Desc)])
  @@map("cash_entries")
}

model CashEntryEvent {
  id          String             @id @default(cuid())
  cashEntryId String
  eventType   CashEntryEventType
  actorId     String // BusinessUser.id
  changes     Json? // before/after diff for EDITED
  reason      String? // for VOIDED
  createdAt   DateTime           @default(now())

  cashEntry CashEntry @relation(fields: [cashEntryId], references: [id], onDelete: Cascade)

  @@index([cashEntryId, createdAt])
  @@map("cash_entry_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PR 4 — Webhook Event Deduplication (MB-1)
// ═══════════════════════════════════════════════════════════════════════════════

/// Idempotency store for inbound webhooks.
/// INSERT before processing; ON CONFLICT DO NOTHING; if 0 rows → replay.
model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  source      String?  @db.VarChar(20)
  payload     Json?
  processedAt DateTime @default(now())
}
