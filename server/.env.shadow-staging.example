# ─────────────────────────────────────────────────────────────────────────────
# Wave A · Stage 1 — scoped-Prisma shadow harness (STAGING)
#
# Copy the values below into the staging environment, restart, and confirm the
# boot log reads:  mode=shadow, client=scoped
#
# This is the STAGING profile: full sample + canary armed. Production toe-dip
# (Stage 3) uses sample=0.01 and ramps from there — do NOT copy sample=1 to prod.
# Full procedure + exit criteria: docs/RUNBOOK_scoped-shadow.md
# ─────────────────────────────────────────────────────────────────────────────

# Mode: off | shadow | enforce.  `shadow` installs the observer, never changes
# what a caller sees.  `enforce` is a SEPARATE, high-risk epic — not this stage.
SCOPED_PRISMA_ENFORCE=shadow

# Fraction of eligible reads observed (0–1). Staging runs at 1 to surface every
# call site fast. In prod this starts at 0.01 and ramps (Stage 3–4).
SCOPED_PRISMA_SHADOW_SAMPLE=1

# The synthetic canary tenant. This value is what `npm run db:seed:canary`
# prints — run that FIRST, then paste its id here. Unset = canary disabled.
SCOPED_PRISMA_SHADOW_CANARY_BUSINESS_ID=shadow-canary-business

# ── Tuning knobs — defaults are correct for Stage 1; shown for completeness.
# Every accessor clamps rather than throws, so a mistype cannot take the API down.
# SCOPED_PRISMA_SHADOW_TIMEOUT_MS=250          # per-probe timeout (1–5000)
# SCOPED_PRISMA_SHADOW_MAX_INFLIGHT=2          # concurrent probe cap (0–5; 0 = probes off)
# SCOPED_PRISMA_SHADOW_SINK_MAX_INFLIGHT=2     # concurrent sink-write cap (0–5)

# ── Post-cutover latch — leave UNSET during shadow. Setting it true forces boot
# to FAIL unless the mode is `enforce`. It belongs to Stage 4, not here.
# SCOPED_PRISMA_CUTOVER_DONE=true

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 acceptance (advance to Stage 2 only when ALL hold):
#   • boot log: mode=shadow, client=scoped
#   • canary row present within 15 min (RUNBOOK §7)
#   • sampled non-zero; distinctFramedRoutes ≥ 20; frame-loss = 0
#   • sinkWriteFailed = 0
#   • p95 within +10% at sample 1.0
# Kill switch (env change + restart, no deploy):  SCOPED_PRISMA_ENFORCE=off
# ─────────────────────────────────────────────────────────────────────────────
