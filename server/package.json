{
  "name": "hisaabpro-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:hsn": "tsx prisma/seed.hsn.ts",
    "db:seed:canary": "tsx prisma/seed.shadow-canary.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "enforce": "node ../scripts/enforce.js",
    "check:soft-delete": "node ../scripts/check-soft-delete.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@prisma/client": "^6.2.0",
    "@sentry/node": "^10.47.0",
    "@types/multer": "^2.1.0",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^3.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.0.0",
    "express-rate-limit": "^8.3.1",
    "fast-xml-parser": "^4.5.6",
    "firebase-admin": "^13.7.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "papaparse": "^5.5.3",
    "razorpay": "^2.9.6",
    "resend": "^6.9.4",
    "svix": "^1.93.0",
    "tsx": "^4.19.0",
    "validator": "^13.15.26",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "yauzl": "^3.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@types/yauzl": "^2.10.3",
    "adm-zip": "^0.5.17",
    "prisma": "^6.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
