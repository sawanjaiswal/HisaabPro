<?xml version="1.0" encoding="utf-8"?>
<!--
  HisaabPro Android network policy.

  Default: cleartext HTTP is DENIED app-wide.
  Permits loopback hostnames for local device/emulator testing:
    · localhost  — device/emulator talking to itself (adb reverse)
    · 10.0.2.2   — Android emulator host alias
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
